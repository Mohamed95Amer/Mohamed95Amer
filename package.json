{
  "name": "goldhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:csv && npm run test:bulk && npm run test:route",
    "test:csv": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/csv.test.ts",
    "test:bulk": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/bulk.test.ts",
    "test:route": "node --experimental-strip-types --no-warnings --import ./scripts/register-stubs.mjs scripts/route.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  }
}
