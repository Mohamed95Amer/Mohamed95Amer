# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...public-anon-key...
# Never expose the service role key to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# --- Gold price providers ---
# Primary provider id: one of "goldapicom" | "goldapi" | "metalpriceapi" | "metalsdev" | "mock"
#
# "goldapicom" (api.gold-api.com) is the default: free, no API key, no signup.
# It is the only provider that works on a fresh deploy with no credentials.
# The others are paid feeds — set the matching *_API_KEY below to use one.
# "mock" emits synthetic data and must never be primary in production.
GOLD_PRICE_PRIMARY_PROVIDER=goldapicom
GOLD_PRICE_BACKUP_PROVIDER=mock

# goldapi.io
GOLDAPI_API_KEY=

# metalpriceapi.com
METALPRICEAPI_API_KEY=

# metals.dev
METALSDEV_API_KEY=

# USD -> AED FX (AED is pegged at ~3.6725; we still allow override)
USD_AED_RATE=3.6725

# Two separate thresholds.
# STALE_AFTER gates selling: a quote older than this locks the reserve button.
GOLD_PRICE_STALE_AFTER_SECONDS=60
# REFRESH_INTERVAL is how often the price is rechecked, and the cadence shown
# to customers. The read endpoint refreshes on this schedule off live traffic.
GOLD_PRICE_REFRESH_INTERVAL_SECONDS=10

# --- Cron auth ---
# Required header value for /api/cron/refresh-gold-price. Vercel Cron sends this via Authorization header
# or you can call the endpoint manually with x-cron-secret.
CRON_SECRET=replace-with-long-random-string

# --- Platform pricing defaults (AED). Admin can override in settings table. ---
PLATFORM_FEE_AED=0
DELIVERY_FEE_AED=0
RESERVATION_LOCK_MINUTES=10

# --- Rate limiting ---
RATE_LIMIT_RESERVATIONS_PER_MIN=5
