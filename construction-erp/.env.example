# Copy this file to .env and replace both values with independent random
# secrets before starting Majal. Never commit the real .env file.
ODOO_ADMIN_PASSWD=replace-with-a-random-32-byte-secret
DB_PASSWORD=replace-with-a-different-random-32-byte-app-secret
# Break-glass database owner; never use this role from the Majal application.
DB_ADMIN_PASSWORD=replace-with-a-third-random-32-byte-secret
