<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_submittal_form" model="ir.ui.view">
        <field name="name">construction.submittal.form</field>
        <field name="model">construction.submittal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit for Review"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_approve_as_noted" type="object"
                            string="Approve as Noted" invisible="state != 'submitted'"/>
                    <button name="action_revise_resubmit" type="object"
                            string="Revise &amp; Resubmit" invisible="state != 'submitted'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state not in ('approved', 'approved_as_noted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h3><field name="name" placeholder="Submittal title"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="submittal_type"/>
                            <field name="spec_section"/>
                            <field name="revision"/>
                            <field name="subcontractor_id"/>
                        </group>
                        <group>
                            <field name="ball_in_court_id"/>
                            <field name="date_required"/>
                            <field name="previous_revision_id" invisible="not previous_revision_id"/>
                            <field name="next_revision_id" invisible="not next_revision_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Review Comments" name="review">
                            <field name="review_comment"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_submittal_list" model="ir.ui.view">
        <field name="name">construction.submittal.list</field>
        <field name="model">construction.submittal</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="submittal_type"/>
                <field name="revision"/>
                <field name="ball_in_court_id"/>
                <field name="date_required"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved', 'approved_as_noted')"
                       decoration-danger="state == 'revise_resubmit'"/>
            </list>
        </field>
    </record>

    <record id="action_construction_submittal" model="ir.actions.act_window">
        <field name="name">Submittals</field>
        <field name="res_model">construction.submittal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_construction_submittal"
              name="Submittals"
              parent="construction_base.menu_construction_engineering"
              action="action_construction_submittal"
              sequence="30"/>
</odoo>
