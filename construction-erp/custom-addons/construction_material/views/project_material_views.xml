<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_material_list" model="ir.ui.view">
        <field name="name">project.project.material.list</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="Material Control" create="false"
                  decoration-danger="material_waste_percent &gt; 5">
                <field name="name"/>
                <field name="construction_stage"/>
                <field name="material_budget_value" sum="Budget"/>
                <field name="material_consumed_value" sum="Consumed"/>
                <field name="material_waste_value" sum="Waste"/>
                <field name="material_waste_percent" string="Waste %"/>
                <field name="material_on_hand_value" sum="On site"/>
                <field name="material_over_budget_count" string="Over budget"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_project_material" model="ir.actions.act_window">
        <field name="name">Material Control</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list</field>
        <field name="domain">[('is_construction', '=', True)]</field>
        <field name="view_id" ref="view_project_material_list"/>
    </record>
</odoo>
