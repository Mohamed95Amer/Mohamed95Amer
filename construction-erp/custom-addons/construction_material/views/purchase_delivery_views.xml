<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_site" model="ir.ui.view">
        <field name="name">purchase.order.form.site</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="construction_project_id"/>
            </field>
        </field>
    </record>

    <record id="view_picking_form_site" model="ir.ui.view">
        <field name="name">stock.picking.form.site</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="construction_project_id" readonly="1"
                       invisible="not construction_project_id"/>
            </field>
        </field>
    </record>

    <record id="action_site_deliveries" model="ir.actions.act_window">
        <field name="name">Site Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('construction_project_id', '!=', False)]</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No site deliveries yet</p>
            <p>Name a construction project on a purchase order and its receipt
               lands in that project's site store.</p>
        </field>
    </record>
</odoo>
