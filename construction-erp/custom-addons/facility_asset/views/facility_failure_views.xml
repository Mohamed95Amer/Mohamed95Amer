<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_failure_code_list" model="ir.ui.view">
        <field name="name">facility.failure.code.list</field>
        <field name="model">facility.failure.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="failure_type"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- The register was an editable list with no form, so the tracked
         history of a code had nowhere to be read. Retyping a code rewrites
         what every past work order appears to have been about; an auditor
         needs somewhere to see that it happened. -->
    <record id="view_failure_code_form" model="ir.ui.view">
        <field name="name">facility.failure.code.form</field>
        <field name="model">facility.failure.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" text="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. No cooling"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="failure_type"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_failure_code" model="ir.actions.act_window">
        <field name="name">Failure Codes</field>
        <field name="res_model">facility.failure.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_type": 1}</field>
    </record>

    <record id="view_failure_code_search" model="ir.ui.view">
        <field name="name">facility.failure.code.search</field>
        <field name="model">facility.failure.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'failure_type'}"/>
            </search>
        </field>
    </record>
</odoo>
