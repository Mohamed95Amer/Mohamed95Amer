<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo Maintenance grants every internal user deletion rights on work
         orders. Majal treats a work order as operational evidence: technicians
         may create and update assigned work, but only equipment managers may
         delete it. The manager ACL from Maintenance remains unchanged. -->
    <record id="maintenance.access_maintenance_system_user" model="ir.model.access">
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_asset_scan_own" model="ir.rule">
        <field name="name">Asset scans: own events</field>
        <field name="model_id" ref="model_facility_asset_scan"/>
        <field name="domain_force">[
            ('user_id', '=', user.id),
            '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_asset_scan_manager" model="ir.rule">
        <field name="name">Asset scans: facility managers</field>
        <field name="model_id" ref="model_facility_asset_scan"/>
        <field name="domain_force">[
            '|', ('company_id', '=', False), ('company_id', 'in', company_ids)
        ]</field>
        <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
    </record>
</odoo>
