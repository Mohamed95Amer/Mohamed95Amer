<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_lease_list" model="ir.ui.view">
        <field name="name">majal.lease.list</field>
        <field name="model">majal.lease</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'terminated', 'expired')"
                  decoration-success="state == 'active'">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="development_id" optional="show"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="annual_rent" sum="Total"/>
                <field name="amount_residual" string="Outstanding" optional="show"/>
                <field name="next_due_date" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state in ('terminated', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_majal_lease_form" model="ir.ui.view">
        <field name="name">majal.lease.form</field>
        <field name="model">majal.lease</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_rent_schedule" type="object"
                            string="Generate Rent Schedule"
                            invisible="state not in ('draft', 'active')"
                            confirm="This replaces the current rent schedule. Continue?"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_renew" type="object" string="Renew"
                            class="btn-primary"
                            invisible="state not in ('active', 'expired')"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not renewed_from_id">
                        Renewal of <field name="renewed_from_id" readonly="1"
                                          class="oe_inline"/>
                    </div>
                    <group>
                        <group string="Unit">
                            <field name="unit_id" readonly="state != 'draft'"/>
                            <field name="development_id"/>
                            <field name="building_id"/>
                            <field name="floor_id"/>
                        </group>
                        <group string="Parties">
                            <field name="tenant_id" readonly="state != 'draft'"/>
                            <field name="landlord_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Term">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="frequency" readonly="state != 'draft'"/>
                            <field name="termination_date"
                                   invisible="state != 'terminated'"/>
                            <field name="termination_reason"
                                   invisible="state != 'terminated'"/>
                        </group>
                        <group string="Money">
                            <field name="currency_id" invisible="1"/>
                            <field name="annual_rent" readonly="state != 'draft'"/>
                            <field name="deposit"/>
                            <field name="deposit_returned"
                                   invisible="state not in ('terminated', 'expired')"/>
                            <field name="amount_scheduled"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                            <field name="next_due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rent Schedule" name="rent">
                            <field name="rent_line_ids">
                                <list editable="bottom" decoration-danger="is_overdue"
                                      decoration-success="state == 'paid'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="due_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_paid" sum="Paid"/>
                                    <field name="amount_residual" sum="Outstanding"/>
                                    <field name="payment_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-warning="state == 'partial'"/>
                                    <button name="action_mark_paid" type="object"
                                            icon="fa-check" title="Mark as fully paid"
                                            invisible="state == 'paid'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Renewals" name="renewals"
                              invisible="not renewal_ids">
                            <field name="renewal_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="annual_rent"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_lease_search" model="ir.ui.view">
        <field name="name">majal.lease.search</field>
        <field name="model">majal.lease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="development_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ended" name="ended"
                        domain="[('state', 'in', ['expired', 'terminated'])]"/>
                <separator/>
                <filter string="Ending Within 60 Days" name="ending_soon"
                        domain="[('state', '=', 'active'),
                                 ('end_date', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter string="With Arrears" name="arrears"
                        domain="[('amount_residual', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                    <filter string="Tenant" name="group_tenant"
                            context="{'group_by': 'tenant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">majal.lease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_lease_search"/>
    </record>

    <record id="view_majal_rent_line_list" model="ir.ui.view">
        <field name="name">majal.lease.rent.line.list</field>
        <field name="model">majal.lease.rent.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-success="state == 'paid'">
                <field name="lease_id"/>
                <field name="unit_id"/>
                <field name="tenant_id"/>
                <field name="name"/>
                <field name="due_date"/>
                <field name="amount" sum="Total"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'partial'"/>
                <button name="action_mark_paid" type="object" icon="fa-check"
                        title="Mark as fully paid" invisible="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_rent_line_search" model="ir.ui.view">
        <field name="name">majal.lease.rent.line.search</field>
        <field name="model">majal.lease.rent.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <filter string="Overdue" name="overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="Unpaid" name="unpaid" domain="[('state', '!=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Tenant" name="group_tenant"
                            context="{'group_by': 'tenant_id'}"/>
                    <filter string="Lease" name="group_lease"
                            context="{'group_by': 'lease_id'}"/>
                    <filter string="Due Date" name="group_due"
                            context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_rent_line" model="ir.actions.act_window">
        <field name="name">Rent Collection</field>
        <field name="res_model">majal.lease.rent.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_majal_rent_line_search"/>
        <field name="context">{'search_default_unpaid': 1}</field>
    </record>
</odoo>
