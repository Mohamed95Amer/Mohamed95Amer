<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_maintenance_request_list" model="ir.ui.view">
        <field name="name">majal.maintenance.request.list</field>
        <field name="model">majal.maintenance.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done', 'cancelled')"
                  decoration-danger="priority == '2' and state in ('new', 'in_progress')">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="development_id" optional="show"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="reported_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_maintenance_request_form" model="ir.ui.view">
        <field name="name">majal.maintenance.request.form</field>
        <field name="model">majal.maintenance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state not in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. AC not cooling"/></h1>
                    </div>
                    <group>
                        <group string="Where">
                            <field name="unit_id"/>
                            <field name="development_id"/>
                            <field name="building_id"/>
                            <field name="lease_id"/>
                        </group>
                        <group string="Who">
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="What">
                            <field name="category"/>
                            <field name="reported_date"/>
                            <field name="closed_date" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Resolution" name="resolution">
                            <field name="resolution" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_maintenance_request_search" model="ir.ui.view">
        <field name="name">majal.maintenance.request.search</field>
        <field name="model">majal.maintenance.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="development_id"/>
                <filter string="Open" name="open"
                        domain="[('state', 'in', ['new', 'in_progress'])]"/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '2')]"/>
                <filter string="Assigned to Me" name="mine"
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">majal.maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_maintenance_request_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
