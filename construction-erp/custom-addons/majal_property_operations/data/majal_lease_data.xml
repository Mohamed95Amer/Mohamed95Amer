<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_majal_lease" model="ir.sequence">
        <field name="name">Lease</field>
        <field name="code">majal.lease</field>
        <field name="prefix">LSE/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_expire_leases" model="ir.cron">
        <field name="name">Property: expire ended leases</field>
        <field name="model_id" ref="model_majal_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
