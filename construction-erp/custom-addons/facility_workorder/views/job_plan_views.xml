<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_plan_form" model="ir.ui.view">
        <field name="name">facility.job.plan.form</field>
        <field name="model">facility.job.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. AHU quarterly service"/></h1>
                    </div>
                    <group>
                        <field name="estimated_duration"/>
                    </group>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_plan_list" model="ir.ui.view">
        <field name="name">facility.job.plan.list</field>
        <field name="model">facility.job.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="estimated_duration"/>
            </list>
        </field>
    </record>

    <record id="action_job_plan" model="ir.actions.act_window">
        <field name="name">Job Plans</field>
        <field name="res_model">facility.job.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
