<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_form_pm_plan" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.pm.plan</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_pm_plans" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not pm_plan_count">
                    <field name="pm_plan_count" widget="statinfo"
                           string="PM Plans"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
