<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_contract" model="ir.ui.view">
        <field name="name">maintenance.request.form.contract</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contract" name="facility_contract"
                      groups="maintenance.group_equipment_manager"
                      invisible="not facility_contract_id">
                    <group>
                        <group>
                            <field name="facility_contract_id"/>
                            <field name="contract_covered"/>
                        </group>
                        <group>
                            <field name="contract_chargeable"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="not contract_chargeable">
                        This work sits outside the scope of the contract —
                        its cost is recoverable from the client.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_maintenance_request_list_contract" model="ir.ui.view">
        <field name="name">maintenance.request.list.contract</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="facility_contract_id" optional="hide"
                       groups="maintenance.group_equipment_manager"/>
                <field name="contract_chargeable" optional="hide"
                       groups="maintenance.group_equipment_manager"/>
            </field>
        </field>
    </record>

    <record id="action_chargeable_work" model="ir.actions.act_window">
        <field name="name">Chargeable Work</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_chargeable', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing outside contract scope
            </p>
            <p>
                Work carried out on contracted assets but outside what the fee
                covers shows here — it is recoverable and easy to forget.
            </p>
        </field>
    </record>
</odoo>
