<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_form_facility" model="ir.ui.view">
        <field name="name">contract.contract.form.facility</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_contract_requests" type="object"
                        icon="fa-wrench" class="oe_stat_button"
                        invisible="not is_amc">
                    <field string="Work Orders" name="request_count"
                           widget="statinfo"/>
                </button>
            </div>
            <group name="main" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not is_amc or days_to_expiry &gt; renewal_notice_days or not date_end">
                    This maintenance contract expires in
                    <field name="days_to_expiry" class="oe_inline"/> day(s).
                </div>
            </group>
            <notebook position="inside">
                <page name="facility_cover" string="Maintenance Cover"
                      invisible="not is_amc">
                    <group>
                        <group string="Scope">
                            <field name="covers_preventive"/>
                            <field name="covers_corrective"/>
                            <field name="covers_parts"/>
                            <field name="pm_visits_included"/>
                            <field name="pm_visits_used"/>
                            <field name="pm_visits_remaining"/>
                        </group>
                        <group string="Commitment">
                            <field name="sla_policy_id"/>
                            <field name="renewal_notice_days"/>
                            <field name="days_to_expiry"/>
                            <field name="renewal_notified"/>
                        </group>
                    </group>
                    <group string="Assets Covered">
                        <field name="equipment_ids" nolabel="1"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Contract Performance">
                        <group>
                            <field name="invoiced_revenue"/>
                            <field name="covered_cost"/>
                        </group>
                        <group>
                            <field name="margin"
                                   decoration-danger="margin &lt; 0"/>
                            <!-- Already expressed 0-100, so the percentage
                                 widget would scale it a second time. -->
                            <field name="margin_percent"/>
                            <field name="chargeable_cost"/>
                        </group>
                    </group>
                    <field name="request_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="maintenance_type"/>
                            <field name="request_date"/>
                            <field name="contract_covered"/>
                            <field name="contract_chargeable"/>
                            <field name="total_cost" sum="Cost"/>
                        </list>
                    </field>
                </page>
            </notebook>
            <field name="tag_ids" position="after">
                <field name="is_amc"/>
            </field>
        </field>
    </record>

    <record id="view_contract_list_facility" model="ir.ui.view">
        <field name="name">contract.contract.list.facility</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_tree_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="margin" optional="show"
                       decoration-danger="margin &lt; 0"/>
                <field name="is_amc" column_invisible="1"/>
            </field>
        </field>
    </record>

    <record id="action_facility_contract" model="ir.actions.act_window">
        <field name="name">Maintenance Contracts</field>
        <field name="res_model">contract.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_amc', '=', True)]</field>
        <field name="context">{'default_is_amc': True, 'default_contract_type': 'sale'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a maintenance contract
            </p>
            <p>
                A maintenance contract covers a list of assets, carries the SLA
                you sold, and shows whether the work being done under it still
                costs less than the fee you charge for it.
            </p>
        </field>
    </record>
</odoo>
