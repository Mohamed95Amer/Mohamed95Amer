<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drawing_form" model="ir.ui.view">
        <field name="name">construction.drawing.form</field>
        <field name="model">construction.drawing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compare_revisions" type="object"
                            string="Compare revisions" icon="fa-columns"
                            class="btn-primary"
                            invisible="revision_count &lt; 2"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" placeholder="AR-101"/></h1>
                        <h3><field name="name" placeholder="Ground Floor Plan"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="discipline"/>
                        </group>
                        <group>
                            <field name="current_revision_id"/>
                            <field name="revision_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revisions" name="revisions">
                            <field name="revision_ids">
                                <list editable="bottom">
                                    <field name="revision"/>
                                    <field name="issued_for"/>
                                    <field name="issue_date"/>
                                    <field name="sheet_file" widget="binary"
                                           filename="sheet_filename"
                                           string="Sheet PDF"/>
                                    <field name="sheet_filename" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'current'"
                                           decoration-muted="state == 'superseded'"/>
                                    <button name="action_make_current" type="object"
                                            string="Make Current" icon="fa-check"
                                            invisible="state == 'current'"/>
                                    <!-- Reachable from the revision line
                                         rather than from the drawing, since
                                         "what changed" is always a question
                                         about a particular revision. -->
                                    <button name="action_compare_revisions"
                                            type="object" string="Compare"
                                            icon="fa-columns"
                                            title="Show this revision beside the one before it"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_drawing_list" model="ir.ui.view">
        <field name="name">construction.drawing.list</field>
        <field name="model">construction.drawing</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="number"/>
                <field name="name"/>
                <field name="discipline"/>
                <field name="current_revision_id"/>
                <field name="revision_count" string="Revisions"/>
            </list>
        </field>
    </record>

    <record id="view_drawing_search" model="ir.ui.view">
        <field name="name">construction.drawing.search</field>
        <field name="model">construction.drawing</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_discipline" string="Discipline"
                        context="{'group_by': 'discipline'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_drawing" model="ir.actions.act_window">
        <field name="name">Drawing Register</field>
        <field name="res_model">construction.drawing</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_construction_drawing"
              name="Drawings"
              parent="construction_base.menu_construction_engineering"
              action="action_construction_drawing"
              sequence="10"/>
</odoo>
