<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_form_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">construction.form.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_form.report_inspection_document</field>
        <field name="report_file">construction_form.report_inspection_document</field>
        <field name="binding_model_id" ref="model_construction_form_inspection"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_inspection_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc">
            <t t-call="web.external_layout"><div class="page">
                <h2><span t-field="doc.template_id"/> — <span t-field="doc.name"/></h2>
                <div class="row mb-3">
                    <div class="col-6"><strong>Project:</strong> <span t-field="doc.project_id"/><br/>
                        <strong>Location:</strong> <span t-field="doc.location"/></div>
                    <div class="col-6"><strong>Date:</strong> <span t-field="doc.scheduled_date"/><br/>
                        <strong>Inspector:</strong> <span t-field="doc.inspector_id"/><br/>
                        <strong>Score:</strong> <span t-esc="'%.1f%%' % doc.score"/></div>
                </div>
                <table class="table table-sm">
                    <thead><tr><th>Question</th><th>Answer</th><th>Comment</th></tr></thead>
                    <tbody><tr t-foreach="doc.answer_ids" t-as="a">
                        <td><span t-field="a.question_id"/></td>
                        <td>
                            <span t-if="a.answer_type == 'yes_no'" t-field="a.answer_yes_no"/>
                            <span t-elif="a.answer_type == 'text'" t-field="a.answer_text"/>
                            <span t-elif="a.answer_type == 'number'" t-field="a.answer_number"/>
                            <span t-elif="a.answer_type == 'date'" t-field="a.answer_date"/>
                            <img t-elif="a.answer_binary" t-att-src="image_data_uri(a.answer_binary)"
                                 style="max-height:120px;max-width:180px;"/>
                        </td>
                        <td><span t-field="a.comment"/></td>
                    </tr></tbody>
                </table>
                <div t-if="doc.notes"><h4>Notes</h4><p t-field="doc.notes"/></div>
            </div></t>
        </t></t>
    </template>
</odoo>
