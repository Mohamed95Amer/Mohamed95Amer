<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_template_list" model="ir.ui.view">
        <field name="name">construction.form.template.list</field>
        <field name="model">construction.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/><field name="name"/><field name="project_id"/>
                <field name="recurring"/><field name="next_run_date"/>
                <field name="inspection_count"/>
            </list>
        </field>
    </record>
    <record id="view_form_template_form" model="ir.ui.view">
        <field name="name">construction.form.template.form</field>
        <field name="model">construction.form.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_inspection" type="object"
                            string="Start Inspection" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="code"/><field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group><field name="responsible_id"/><field name="recurring"/>
                            <field name="recurrence_interval" invisible="not recurring"/>
                            <field name="recurrence_unit" invisible="not recurring"/>
                            <field name="next_run_date" invisible="not recurring"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section"/><field name="name"/>
                                    <field name="answer_type"/><field name="required"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instructions"><field name="description"/></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_form_inspection_list" model="ir.ui.view">
        <field name="name">construction.form.inspection.list</field>
        <field name="model">construction.form.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="scheduled_date"/>
                <field name="project_id"/><field name="template_id"/>
                <field name="inspector_id"/><field name="score"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'submitted'"/>
            </list>
        </field>
    </record>
    <record id="view_form_inspection_form" model="ir.ui.view">
        <field name="name">construction.form.inspection.form</field>
        <field name="model">construction.form.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="construction_base.group_construction_pm"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="construction_base.group_construction_pm"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state not in ['submitted', 'rejected']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="template_id" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="location"/></group>
                        <group><field name="scheduled_date"/><field name="inspector_id"/>
                            <field name="completed_date"/><field name="score"/></group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="answer_ids" readonly="state not in ['draft', 'in_progress']">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="question_id" readonly="1"/>
                                    <field name="answer_type" column_invisible="True"/>
                                    <field name="answer_yes_no" invisible="answer_type != 'yes_no'"/>
                                    <field name="answer_text" invisible="answer_type != 'text'"/>
                                    <field name="answer_number" invisible="answer_type != 'number'"/>
                                    <field name="answer_date" invisible="answer_type != 'date'"/>
                                    <field name="answer_binary" filename="answer_filename"
                                           invisible="answer_type not in ['photo', 'signature']"/>
                                    <field name="answer_filename" column_invisible="True"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_form_inspection_search" model="ir.ui.view">
        <field name="name">construction.form.inspection.search</field>
        <field name="model">construction.form.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="project_id"/>
                <field name="template_id" filter_domain="[('template_id', '=', self)]"/>
                <field name="inspector_id"/>
                <filter name="my_inspections" string="My Inspections"
                        domain="[('inspector_id', '=', uid)]"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_form_templates" model="ir.actions.act_window">
        <field name="name">Form Templates</field>
        <field name="res_model">construction.form.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_form_inspections" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">construction.form.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_form_inspection_search"/>
    </record>
    <menuitem id="menu_construction_forms" name="Forms &amp; Inspections"
              parent="construction_daily_log.menu_construction_site"
              action="action_form_inspections" sequence="20"/>
    <menuitem id="menu_construction_form_templates" name="Form Templates"
              parent="construction_base.menu_construction_config"
              action="action_form_templates" sequence="40"/>
</odoo>
