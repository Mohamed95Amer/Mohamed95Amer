<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_form_inspection" model="ir.sequence">
        <field name="name">Construction Inspection</field>
        <field name="code">construction.form.inspection</field>
        <field name="prefix">INSP/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="ir_cron_recurring_inspections" model="ir.cron">
        <field name="name">Construction: Generate Recurring Inspections</field>
        <field name="model_id" ref="model_construction_form_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_recurring_inspections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- The standard forms, installed once. Ordinary records afterwards: edit,
         copy or delete them per project. Nothing is re-imposed on upgrade. -->
    <function model="construction.form.library" name="_install_library"
              eval="[]"/>
</odoo>
