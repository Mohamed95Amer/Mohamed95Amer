<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_maintenance_request_form_facilities" model="ir.ui.view">
        <field name="name">majal.maintenance.request.form.facilities</field>
        <field name="model">majal.maintenance.request</field>
        <field name="inherit_id"
               ref="majal_property_operations.view_majal_maintenance_request_form"/>
        <field name="arch" type="xml">
            <button name="action_start" position="after">
                <button name="action_escalate_to_facilities" type="object"
                        string="Escalate to Facilities" class="btn-primary"
                        invisible="maintenance_request_id or state in ('done', 'cancelled')"/>
                <button name="action_view_work_order" type="object"
                        string="Open Work Order"
                        invisible="not maintenance_request_id"/>
            </button>
            <!-- Anchored on a field: view inheritance may not select on
                 'string'. -->
            <field name="category" position="after">
                <field name="maintenance_request_id" readonly="1"
                       invisible="not maintenance_request_id"/>
            </field>
        </field>
    </record>

    <record id="view_majal_maintenance_request_list_facilities" model="ir.ui.view">
        <field name="name">majal.maintenance.request.list.facilities</field>
        <field name="model">majal.maintenance.request</field>
        <field name="inherit_id"
               ref="majal_property_operations.view_majal_maintenance_request_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="maintenance_request_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
