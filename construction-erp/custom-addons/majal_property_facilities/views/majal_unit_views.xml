<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_unit_form_facilities" model="ir.ui.view">
        <field name="name">majal.unit.form.facilities</field>
        <field name="model">majal.unit</field>
        <field name="inherit_id" ref="majal_real_estate.view_majal_unit_form"/>
        <field name="arch" type="xml">
            <!-- Anchored on the outer group, not on a group's string: view
                 inheritance may not select on 'string'. -->
            <xpath expr="//sheet/group[1]" position="inside">
                <group string="Facilities">
                    <field name="facility_location_id" readonly="1"/>
                    <field name="facility_published" invisible="1"/>
                    <button name="action_publish_to_facilities" type="object"
                            string="Publish to Facilities" class="btn-link"
                            invisible="facility_published"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
