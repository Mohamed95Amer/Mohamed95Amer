<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="settings_icon_purchase" model="ir.ui.view">
        <field name="name">settings.icon.purchase.majal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="attributes">
                <attribute name="logo">/construction_ui/static/description/apps/purchase.svg</attribute>
            </xpath>
        </field>
    </record>

