<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="majal_web_layout" inherit_id="web.layout" name="Majal Web Identity" priority="110">
        <xpath expr="//title" position="replace">
            <t t-set="majal_product_name"
               t-value="request.env['ir.config_parameter'].sudo().get_param('majal.product_name', 'Majal')"/>
            <title t-esc="title or majal_product_name"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">'/majal_branding/static/description/icon.svg?v=20260802'</attribute>
        </xpath>
        <xpath expr="//head" position="inside">
            <t t-set="majal_brand_colours"
               t-value="request.env['res.config.settings'].sudo()._get_majal_brand_colours()"/>
            <style id="majal-brand-tokens">
                :root {
                    --majal-nav: <t t-out="majal_brand_colours['nav']"/>;
                    --majal-primary: <t t-out="majal_brand_colours['primary']"/>;
                    --majal-accent: <t t-out="majal_brand_colours['accent']"/>;
                }
            </style>
        </xpath>
    </template>

    <template id="majal_webclient_bootstrap"
              inherit_id="web.webclient_bootstrap"
              name="Majal Installed App Identity"
              priority="110">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content">#173240</attribute>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/majal_branding/static/src/img/majal-assistant.png</attribute>
        </xpath>
        <!-- The platform router still parses its upstream /odoo path. On a
             branded /app deep-link, normalize before the router module starts;
             the Majal router extension changes the displayed URL back after
             bootstrap and for all later navigation. -->
        <xpath expr="//t[@t-set='head_web']/script[1]" position="before">
            <script type="text/javascript">
                if (window.location.pathname === '/app' || window.location.pathname.startsWith('/app/')) {
                    const upstreamPath = window.location.pathname.replace(/^\/app/, '/odoo');
                    window.history.replaceState(window.history.state, '', upstreamPath + window.location.search + window.location.hash);
                }
            </script>
        </xpath>
    </template>

    <template id="majal_brand_promotion"
              inherit_id="web.brand_promotion"
              name="Majal Product Footer"
              priority="110">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion o_majal_product_footer">
                <span>Majal</span>
                <span aria-hidden="true"> · </span>
                <span>Construction &amp; Facilities</span>
            </div>
        </xpath>
    </template>

    <template id="majal_login_legal_link"
              inherit_id="construction_ui.majal_login_layout"
              name="Majal Login Legal Link"
              priority="110">
        <xpath expr="//div[hasclass('o_majal_login_footer')]" position="inside">
            <span aria-hidden="true"> · </span>
            <a href="/majal/about">About Majal</a>
            <span aria-hidden="true"> · </span>
            <a href="/majal/legal/open-source">Third-party licences</a>
        </xpath>
    </template>
</odoo>
