<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each block below is one panel on the Construction dashboard. They are
         separate actions rather than one action with many views, because a
         board panel renders a single view and a director should be able to
         click any panel through to the records behind it. -->

    <record id="view_construction_report_pivot" model="ir.ui.view">
        <field name="name">majal.construction.report.pivot</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <pivot string="Commercial Position" sample="1">
                <field name="construction_stage" type="row"/>
                <field name="contract_value" type="measure"/>
                <field name="certified_value" type="measure"/>
                <field name="cost_to_date" type="measure"/>
                <field name="forecast_margin" type="measure"/>
                <field name="margin_variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_construction_report_graph_margin" model="ir.ui.view">
        <field name="name">majal.construction.report.graph.margin</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <!-- Horizontal bars, ordered worst first. A portfolio chart is
                 read to find the job in trouble, not to admire the healthy
                 ones. -->
            <graph string="Forecast Margin by Project" type="bar"
                   sample="1" order="ASC">
                <field name="project_id"/>
                <field name="forecast_margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_construction_report_graph_movement" model="ir.ui.view">
        <field name="name">majal.construction.report.graph.movement</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <graph string="Margin Movement Since Tender" type="bar"
                   sample="1" order="ASC">
                <field name="project_id"/>
                <field name="margin_variance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_construction_report_graph_exposure" model="ir.ui.view">
        <field name="name">majal.construction.report.graph.exposure</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <!-- Work done but not yet certified is the money the business has
                 spent and not yet been paid for. -->
            <graph string="Certified vs Cost" type="bar" sample="1">
                <field name="project_id"/>
                <field name="certified_value" type="measure"/>
                <field name="cost_to_date" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_construction_report_list" model="ir.ui.view">
        <field name="name">majal.construction.report.list</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <list string="Portfolio" create="0" sample="1"
                  decoration-danger="margin_variance &lt; 0"
                  decoration-muted="construction_stage == 'closed'">
                <field name="project_id"/>
                <field name="construction_stage"/>
                <field name="contract_value" sum="Contract"/>
                <field name="certified_value" sum="Certified"/>
                <field name="percent_complete" widget="percentage" optional="show"/>
                <field name="cost_to_date" sum="Cost" optional="show"/>
                <field name="forecast_margin" sum="Forecast margin"/>
                <field name="margin_variance" sum="Movement"/>
                <field name="open_rfi_count" optional="hide"/>
                <field name="open_defect_count" optional="hide"/>
                <field name="variation_count" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_report_search" model="ir.ui.view">
        <field name="name">majal.construction.report.search</field>
        <field name="model">majal.construction.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="live" string="Live jobs"
                        domain="[('construction_stage','not in',['closed'])]"/>
                <filter name="losing" string="Below tendered margin"
                        domain="[('margin_variance','&lt;',0)]"/>
                <separator/>
                <filter name="group_stage" string="Stage" context="{'group_by':'construction_stage'}"/>
                <filter name="group_client" string="Client" context="{'group_by':'partner_id'}"/>
                <filter name="group_pm" string="Project Manager" context="{'group_by':'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolio</field>
        <field name="res_model">majal.construction.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="action_construction_margin" model="ir.actions.act_window">
        <field name="name">Forecast Margin by Project</field>
        <field name="res_model">majal.construction.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_construction_report_graph_margin"/>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="action_construction_movement" model="ir.actions.act_window">
        <field name="name">Margin Movement</field>
        <field name="res_model">majal.construction.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_construction_report_graph_movement"/>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="action_construction_exposure" model="ir.actions.act_window">
        <field name="name">Certified vs Cost</field>
        <field name="res_model">majal.construction.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_construction_report_graph_exposure"/>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <!-- The approvals inbox in construction_base is a server action, which a
         board panel cannot render — a panel loads an action and draws one of
         its views. This is the same records as a plain window action. -->
    <record id="action_dashboard_approvals" model="ir.actions.act_window">
        <field name="name">Approvals Waiting</field>
        <field name="res_model">construction.approval.step</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','pending'),('request_id.state','=','pending')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_construction_position" model="ir.actions.act_window">
        <field name="name">Commercial Position</field>
        <field name="res_model">majal.construction.report</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_construction_report_pivot"/>
    </record>
</odoo>
