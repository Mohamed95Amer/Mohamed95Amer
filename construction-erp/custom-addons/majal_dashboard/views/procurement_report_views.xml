<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_report_graph_commitment" model="ir.ui.view">
        <field name="name">majal.procurement.report.graph.commitment</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <!-- Split by source, because materials and packages are bought
                 differently and a job's exposure is the sum of both. -->
            <graph string="Commitment by Project" type="bar" stacked="1"
                   sample="1">
                <field name="project_id"/>
                <field name="source"/>
                <field name="amount_committed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_procurement_report_graph_vendor" model="ir.ui.view">
        <field name="name">majal.procurement.report.graph.vendor</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <graph string="Spend by Vendor" type="bar" sample="1" order="DESC">
                <field name="partner_id"/>
                <field name="amount_committed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_procurement_report_graph_outstanding" model="ir.ui.view">
        <field name="name">majal.procurement.report.graph.outstanding</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <!-- Ordered and not yet delivered: the money sitting with
                 suppliers, which is the number a buyer chases. -->
            <graph string="Ordered, Not Yet Received" type="bar" sample="1"
                   order="DESC">
                <field name="partner_id"/>
                <field name="amount_outstanding" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_procurement_report_pivot" model="ir.ui.view">
        <field name="name">majal.procurement.report.pivot</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <pivot string="Procurement" sample="1">
                <field name="project_id" type="row"/>
                <field name="source" type="col"/>
                <field name="amount_committed" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_procurement_report_list" model="ir.ui.view">
        <field name="name">majal.procurement.report.list</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <list string="Commitments" create="0" sample="1"
                  decoration-danger="is_late">
                <field name="date_order"/>
                <field name="source"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="description" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="qty_ordered" optional="hide"/>
                <field name="qty_received" optional="hide"/>
                <field name="amount_committed" sum="Committed"/>
                <field name="amount_outstanding" sum="Outstanding" optional="show"/>
                <field name="is_late" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_procurement_report_search" model="ir.ui.view">
        <field name="name">majal.procurement.report.search</field>
        <field name="model">majal.procurement.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="purchases" string="Purchase orders"
                        domain="[('source','=','purchase')]"/>
                <filter name="subcontracts" string="Subcontracts"
                        domain="[('source','=','subcontract')]"/>
                <filter name="late" string="Past due"
                        domain="[('is_late','=',True)]"/>
                <filter name="outstanding" string="Not yet received"
                        domain="[('amount_outstanding','&gt;',0)]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_vendor" string="Vendor" context="{'group_by':'partner_id'}"/>
                <filter name="group_source" string="Type" context="{'group_by':'source'}"/>
                <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_procurement_commitment" model="ir.actions.act_window">
        <field name="name">Commitment by Project</field>
        <field name="res_model">majal.procurement.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_procurement_report_graph_commitment"/>
    </record>

    <record id="action_procurement_vendor" model="ir.actions.act_window">
        <field name="name">Spend by Vendor</field>
        <field name="res_model">majal.procurement.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_procurement_report_graph_vendor"/>
    </record>

    <record id="action_procurement_outstanding" model="ir.actions.act_window">
        <field name="name">Ordered, Not Yet Received</field>
        <field name="res_model">majal.procurement.report</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_procurement_report_graph_outstanding"/>
        <field name="context">{'search_default_purchases': 1}</field>
    </record>

    <record id="action_procurement_late" model="ir.actions.act_window">
        <field name="name">Past Due Deliveries</field>
        <field name="res_model">majal.procurement.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_late': 1}</field>
    </record>

    <record id="action_procurement_pivot" model="ir.actions.act_window">
        <field name="name">Procurement Analysis</field>
        <field name="res_model">majal.procurement.report</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_procurement_report_pivot"/>
    </record>
</odoo>
