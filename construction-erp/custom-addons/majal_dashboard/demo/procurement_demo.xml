<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Real purchase orders make the procurement board useful on a fresh
         demo database.  They are tied to the same construction projects and
         products used by the material demo, so the commitment and outstanding
         figures have a traceable source rather than invented chart values. -->
    <record id="partner_demo_supplier_concrete" model="res.partner">
        <field name="name">Emirates Ready Mix Supply</field>
        <field name="is_company" eval="True"/>
        <field name="supplier_rank">10</field>
    </record>
    <record id="partner_demo_supplier_steel" model="res.partner">
        <field name="name">Gulf Steel Trading</field>
        <field name="is_company" eval="True"/>
        <field name="supplier_rank">10</field>
    </record>

    <record id="po_demo_alnoor_concrete" model="purchase.order">
        <field name="partner_id" ref="partner_demo_supplier_concrete"/>
        <field name="construction_project_id"
               ref="construction_base.project_demo_alnoor"/>
        <field name="order_line" eval="[(0, 0, {
            'product_id': ref('construction_material.product_concrete'),
            'name': 'Ready-mix concrete C30/37',
            'product_qty': 1200.0,
            'product_uom': ref('uom.product_uom_cubic_meter'),
            'price_unit': 62.0,
            'date_planned': '2026-08-05 08:00:00',
        })]"/>
    </record>
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('po_demo_alnoor_concrete')]"/>
    </function>

    <record id="po_demo_marina_steel" model="purchase.order">
        <field name="partner_id" ref="partner_demo_supplier_steel"/>
        <field name="construction_project_id"
               ref="construction_base.project_demo_marina"/>
        <field name="order_line" eval="[(0, 0, {
            'product_id': ref('construction_material.product_rebar'),
            'name': 'Reinforcement steel B500B',
            'product_qty': 80.0,
            'product_uom': ref('uom.product_uom_ton'),
            'price_unit': 720.0,
            'date_planned': '2026-09-05 08:00:00',
        })]"/>
    </record>
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('po_demo_marina_steel')]"/>
    </function>
</odoo>
