<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- A ready-to-run instance of the trading summary.

             The template on its own is a definition, not a screen. Shipping
             only the definition means a user opening Financial Reports lands
             on an empty list and concludes the feature is missing — which is
             what happened the first time this was driven in a browser.

             Periods are relative, not fixed. Fixed dates would be correct in
             2026 and quietly wrong every year after, which is the kind of
             error nobody notices until a board pack goes out with last
             year's window on it. Relative periods resolve against the
             report's base date, so this stays right without being edited.

             Two periods rather than one: a margin with nothing to compare it
             against is a number, and what a director needs is a direction.
             offset=0 is the current year, offset=-1 the one before it. -->

        <record id="mis_instance_trading" model="mis.report.instance">
            <field name="name">Trading Summary — this year against last</field>
            <field name="report_id" ref="mis_report_trading"/>
            <field name="comparison_mode" eval="True"/>
        </record>

        <record id="mis_instance_period_current" model="mis.report.instance.period">
            <field name="report_instance_id" ref="mis_instance_trading"/>
            <field name="name">This year</field>
            <field name="sequence">10</field>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">0</field>
            <field name="duration">1</field>
        </record>

        <record id="mis_instance_period_previous" model="mis.report.instance.period">
            <field name="report_instance_id" ref="mis_instance_trading"/>
            <field name="name">Last year</field>
            <field name="sequence">20</field>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">-1</field>
            <field name="duration">1</field>
        </record>
    </data>
</odoo>
