<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_notification_list" model="ir.ui.view">
        <field name="name">majal.property.notification.list</field>
        <field name="model">majal.property.notification</field>
        <field name="arch" type="xml">
            <list string="Property Reminders" create="0" delete="0">
                <field name="due_date"/>
                <field name="kind" widget="badge"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'ready'"
                       decoration-warning="state in ('queued', 'skipped')"
                       decoration-success="state == 'sent'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_property_notification_form" model="ir.ui.view">
        <field name="name">majal.property.notification.form</field>
        <field name="model">majal.property.notification</field>
        <field name="arch" type="xml">
            <form string="Property Reminder" create="0" delete="0">
                <header>
                    <button name="action_open_record" type="object" string="Open Record" class="btn-primary"/>
                    <button name="action_queue_email" type="object" string="Queue Email"
                            groups="majal_property_integrations.group_majal_property_integration_manager"
                            invisible="state not in ('ready', 'skipped')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="majal_property_integrations.group_majal_property_integration_manager"
                            invisible="state in ('sent', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="ready,queued,sent,skipped,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="subject" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="due_date" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="email_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="mail_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="body_html" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_notification" model="ir.actions.act_window">
        <field name="name">Property Reminders</field>
        <field name="res_model">majal.property.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_property_notification_settings_list" model="ir.ui.view">
        <field name="name">majal.property.notification.settings.list</field>
        <field name="model">majal.property.notification.settings</field>
        <field name="arch" type="xml">
            <list string="Reminder Policies">
                <field name="company_id"/>
                <field name="active"/>
                <field name="email_enabled"/>
                <field name="installment_days"/>
                <field name="lease_days"/>
                <field name="reservation_days"/>
                <field name="document_days"/>
            </list>
        </field>
    </record>
    <record id="view_property_notification_settings_form" model="ir.ui.view">
        <field name="name">majal.property.notification.settings.form</field>
        <field name="model">majal.property.notification.settings</field>
        <field name="arch" type="xml">
            <form string="Property Reminder Policy">
                <sheet>
                    <div class="oe_title"><h1><field name="company_id"/></h1></div>
                    <group>
                        <group string="Delivery">
                            <field name="active"/>
                            <field name="email_enabled"/>
                        </group>
                        <group string="Advance Notice (days)">
                            <field name="installment_days"/>
                            <field name="lease_days"/>
                            <field name="reservation_days"/>
                            <field name="document_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_notification_settings" model="ir.actions.act_window">
        <field name="name">Reminder Policies</field>
        <field name="res_model">majal.property.notification.settings</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
