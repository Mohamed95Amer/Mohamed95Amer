              parent="construction_base.menu_construction_root" sequence="46"/>
    <menuitem id="menu_meetings" name="Meetings &amp; Minutes"
              parent="menu_meeting_root" action="action_meeting" sequence="10"/>
    <menuitem id="menu_meeting_actions" name="Action Items"
              parent="menu_meeting_root" action="action_meeting_action" sequence="20"/>
</odoo>
