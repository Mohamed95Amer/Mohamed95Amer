<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drawing_form_rfi" model="ir.ui.view">
        <field name="name">construction.drawing.form.rfi</field>
        <field name="model">construction.drawing</field>
        <field name="inherit_id" ref="construction_drawing.view_drawing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_citing_rfis" type="object"
                            class="oe_stat_button" icon="fa-question-circle"
                            invisible="not citing_rfi_count">
                        <field name="citing_rfi_count" widget="statinfo"
                               string="RFIs"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
