<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_report_catalog_list" model="ir.ui.view">
        <field name="name">majal.report.catalog.list</field>
        <field name="model">majal.report.catalog</field>
        <field name="arch" type="xml">
            <list string="Report Studio" create="0" decoration-muted="not active">
                <header>
                    <button name="action_refresh_catalog" type="object"
                            string="Refresh report catalogue"
                            groups="majal_administration.group_user_administrator"/>
                </header>
                <field name="sequence" column_invisible="1"/>
                <field name="name"/>
                <field name="category"/>
                <field name="source_model" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="show"/>
                <button name="action_open_source_records" type="object"
                        string="Open records" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_majal_report_catalog_form" model="ir.ui.view">
        <field name="name">majal.report.catalog.form</field>
        <field name="model">majal.report.catalog</field>
        <field name="arch" type="xml">
            <form string="Majal Report Studio">
                <header>
                    <button name="action_open_source_records" type="object"
                            string="Open source records" class="btn-primary"/>
                    <field name="active" widget="boolean_button"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="majal_report_studio_intro alert alert-info" role="status">
                        Choose the source record, then use its branded print action
                        to produce the final PDF.
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="company_id"/>
                            <field name="source_model" readonly="1"/>
                        </group>
                        <group>
                            <field name="report_action_id" readonly="1"/>
                            <field name="report_name" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="description" placeholder="How this report is used..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_majal_report_catalog_search" model="ir.ui.view">
        <field name="name">majal.report.catalog.search</field>
        <field name="model">majal.report.catalog</field>
        <field name="arch" type="xml">
            <search string="Find a report">
                <field name="name"/>
                <field name="source_model"/>
                <filter name="active" string="Available" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Area"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_report_catalog" model="ir.actions.act_window">
        <field name="name">Report Studio</field>
        <field name="res_model">majal.report.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_majal_report_catalog_list"/>
        <field name="search_view_id" ref="view_majal_report_catalog_search"/>
        <field name="domain">[('active', '=', True)]</field>
    </record>
</odoo>
