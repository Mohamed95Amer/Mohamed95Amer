<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_integration_job_list" model="ir.ui.view">
        <field name="name">majal.integration.job.list</field>
        <field name="model">majal.integration.job</field>
        <field name="arch" type="xml">
            <list string="Integration Jobs" create="0" delete="0">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="operation"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('pending', 'processing')"
                       decoration-warning="state == 'retry'"
                       decoration-success="state == 'succeeded'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at" optional="hide"/>
                <field name="external_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_majal_integration_job_form" model="ir.ui.view">
        <field name="name">majal.integration.job.form</field>
        <field name="model">majal.integration.job</field>
        <field name="arch" type="xml">
            <form string="Integration Job" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state not in ('failed', 'retry')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('pending', 'retry', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,retry,succeeded,failed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="provider_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="operation" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="attempt_count" readonly="1"/>
                            <field name="next_attempt_at" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Linked Record">
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <group string="Result">
                        <field name="external_id" readonly="1"/>
                        <field name="response_summary" readonly="1"/>
                        <field name="error" readonly="1"/>
                    </group>
                    <group string="Provider-neutral Payload">
                        <field name="payload" readonly="1" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_integration_job" model="ir.actions.act_window">
        <field name="name">Integration Jobs</field>
        <field name="res_model">majal.integration.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
