<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_majal_property_account" model="ir.module.category">
        <field name="name">Property Accounting</field>
        <field name="sequence">28</field>
    </record>
    <record id="group_majal_property_account_manager" model="res.groups">
        <field name="name">Property Accounting Manager</field>
        <field name="category_id" ref="module_category_majal_property_account"/>
        <field name="implied_ids" eval="[(4, ref('majal_real_estate.group_majal_real_estate_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_majal_property_accounting_settings_company" model="ir.rule">
        <field name="name">Property accounting settings: allowed companies</field>
        <field name="model_id" ref="model_majal_property_accounting_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
