<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_sales_sequence_list" model="ir.ui.view">
        <field name="name">majal.sales.sequence.list</field>
        <field name="model">majal.sales.sequence</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lang"/>
                <field name="country_codes"/>
                <field name="step_count"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_majal_sales_sequence_form" model="ir.ui.view">
        <field name="name">majal.sales.sequence.form</field>
        <field name="model">majal.sales.sequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="lang"/>
                            <field name="country_codes"
                                   placeholder="AE,SA,EG"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="step_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="day_offset"/>
                            <field name="name"/>
                            <field name="channel"/>
                            <field name="mail_template_id"
                                   required="channel == 'email'"/>
                            <field name="body"
                                   invisible="channel == 'email'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_sales_sequence" model="ir.actions.act_window">
        <field name="name">Sequences</field>
        <field name="res_model">majal.sales.sequence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
