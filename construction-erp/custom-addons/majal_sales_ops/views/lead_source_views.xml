<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_lead_source_list" model="ir.ui.view">
        <field name="name">majal.lead.source.list</field>
        <field name="model">majal.lead.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="lead_count" string="Leads"/>
            </list>
        </field>
    </record>

    <record id="view_majal_lead_source_form" model="ir.ui.view">
        <field name="name">majal.lead.source.form</field>
        <field name="model">majal.lead.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="kind"/>
                        <field name="active"/>
                        <field name="lead_count"/>
                    </group>
                    <group string="How this list was assembled">
                        <field name="notes" nolabel="1"
                               placeholder="In enough detail that somebody else could repeat it or challenge it."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_lead_source" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">majal.lead.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
