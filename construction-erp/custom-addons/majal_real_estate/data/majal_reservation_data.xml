<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_majal_reservation" model="ir.sequence">
        <field name="name">Unit Reservation</field>
        <field name="code">majal.reservation</field>
        <field name="prefix">RES/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_majal_handover" model="ir.sequence">
        <field name="name">Unit Handover</field>
        <field name="code">majal.handover</field>
        <field name="prefix">HO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_expire_reservations" model="ir.cron">
        <field name="name">Real Estate: expire lapsed reservations</field>
        <field name="model_id" ref="model_majal_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_reservations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
