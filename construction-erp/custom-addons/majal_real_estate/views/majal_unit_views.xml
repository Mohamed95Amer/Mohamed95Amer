<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_unit_list" model="ir.ui.view">
        <field name="name">majal.unit.list</field>
        <field name="model">majal.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="development_id"/>
                <field name="building_id"/>
                <field name="floor_id"/>
                <field name="unit_category"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="total_area"/>
                <field name="view"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-danger="status == 'sold'"
                       decoration-warning="status == 'reserved'"/>
                <field name="list_price" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_majal_unit_form" model="ir.ui.view">
        <field name="name">majal.unit.form</field>
        <field name="model">majal.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="planned,available,reserved,sold,handed_over"/>
                </header>
                <sheet class="o_majal_unit_sheet">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object"
                                class="oe_stat_button" icon="fa-bookmark">
                            <field name="reservation_count" widget="statinfo"
                                   string="Reservations"/>
                        </button>
                        <button name="action_view_handovers" type="object"
                                class="oe_stat_button" icon="fa-key"
                                invisible="not handover_ids">
                            <field name="handover_count" widget="statinfo"
                                   string="Handovers"/>
                        </button>
                    </div>
                    <div class="o_majal_unit_overview">
                        <div class="o_majal_unit_photo"><field name="marketing_image" widget="image" class="oe_avatar" options="{'preview_image': 'marketing_image'}"/><span>Living space and property view</span></div>
                        <div class="o_majal_unit_summary"><div class="o_majal_unit_badges"><field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'reserved'" decoration-danger="status == 'blocked'"/><span>Ready</span><span>Premium</span></div><small><field name="development_id"/> · <field name="building_id"/></small><h1><field name="name" placeholder="e.g. A-1204"/></h1><p><field name="bedrooms"/> bedrooms · <field name="view"/> view</p><h2><field name="list_price" widget="monetary"/></h2><div class="o_majal_unit_facts"><span><small>AREA</small><b><field name="total_area"/> sq ft</b></span><span><small>FLOOR</small><b><field name="floor_id"/></b></span><span><small>BEDROOMS</small><b><field name="bedrooms"/></b></span></div><div class="o_majal_readiness"><div class="o_form_label">Listing readiness <b><field name="listing_readiness"/>%</b></div><field name="listing_readiness" widget="progressbar"/><div class="o_form_label">Document pack <b><field name="document_count"/> of 9</b></div><field name="document_readiness" widget="progressbar"/></div></div>
                    </div>
                    <div class="o_majal_unit_lifecycle"><span class="done"><i>✓</i><b>Listing ready</b></span><span class="done"><i>✓</i><b>Visit complete</b></span><span class="current"><i>3</i><b>Offer issued</b></span><span><i>4</i><b>Reservation</b></span><span><i>5</i><b>Contract</b></span><span><i>6</i><b>Handover</b></span></div>
                    <div class="alert alert-info" role="alert"
                         invisible="not active_reservation_id">
                        Held by <field name="active_reservation_id" readonly="1"
                                       class="oe_inline"/>
                    </div>
                    <notebook>
                      <page string="Overview" name="overview"><group>
                        <group string="Location">
                            <field name="development_id"/>
                            <field name="building_id"/>
                            <field name="floor_id"
                                   domain="[('building_id', '=', building_id)]"/>
                            <field name="community_id" invisible="not community_id"/>
                            <field name="owner_id" invisible="not owner_id"/>
                        </group>
                        <group string="Type">
                            <field name="unit_type_id"
                                   domain="[('development_id', '=', development_id)]"/>
                            <field name="unit_category"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                        </group>
                        <group string="Area (sqft)">
                            <field name="suite_area"/>
                            <field name="balcony_area"/>
                            <field name="total_area"/>
                        </group>
                        <group string="Position">
                            <field name="view"/>
                            <field name="orientation"/>
                            <field name="parking_ref"/>
                        </group>
                        <group string="Pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="list_price"/>
                            <field name="price_per_sqft"/>
                        </group>
                      </group></page>
                      <page string="Commercial" name="commercial"><group><group string="Pricing"><field name="currency_id" invisible="1"/><field name="list_price"/><field name="price_per_sqft"/><field name="active_reservation_id"/></group><group string="Availability"><field name="status"/><field name="owner_id"/><field name="reservation_count"/><field name="handover_count"/></group></group></page>
                      <page string="Documents" name="documents"><field name="document_ids" context="{'default_unit_id': id}"/></page>
                      <page string="History" name="history"><field name="reservation_ids" context="{'default_unit_id': id}"/><field name="handover_ids" context="{'default_unit_id': id}"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_unit_kanban" model="ir.ui.view">
        <field name="name">majal.unit.kanban</field>
        <field name="model">majal.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="floor_id" records_draggable="0">
                <field name="name"/>
                <field name="status"/>
                <field name="unit_category"/>
                <field name="bedrooms"/>
                <field name="total_area"/>
                <field name="view"/>
                <field name="list_price"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div t-att-class="'oe_kanban_card o_kanban_record p-2 border ' +
                            (record.status.raw_value === 'available' ? 'border-success' :
                             record.status.raw_value === 'sold' ? 'border-danger' :
                             record.status.raw_value === 'reserved' ? 'border-warning' :
                             'border-secondary')">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="fs-5"><field name="name"/></strong>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'available'"
                                       decoration-danger="status == 'sold'"
                                       decoration-warning="status == 'reserved'"/>
                            </div>
                            <div class="text-muted small">
                                <field name="unit_category"/>
                                <span t-if="record.bedrooms.raw_value"> ·
                                    <field name="bedrooms"/> bed</span>
                                <span t-if="record.total_area.raw_value"> ·
                                    <field name="total_area"/> sqft</span>
                            </div>
                            <div class="mt-1 fw-bold">
                                <field name="list_price" widget="monetary"/>
                            </div>
                            <div class="text-muted small" t-if="record.view.raw_value">
                                <i class="fa fa-eye me-1" title="View"/><field name="view"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_majal_unit_search" model="ir.ui.view">
        <field name="name">majal.unit.search</field>
        <field name="model">majal.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="development_id"/>
                <field name="building_id"/>
                <field name="floor_id"/>
                <field name="unit_type_id"/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Reserved" name="reserved" domain="[('status', '=', 'reserved')]"/>
                <filter string="Sold" name="sold" domain="[('status', '=', 'sold')]"/>
                <group expand="0" string="Group By">
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building_id'}"/>
                    <filter string="Floor" name="group_floor"
                            context="{'group_by': 'floor_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">majal.unit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_majal_unit_search"/>
    </record>
</odoo>
