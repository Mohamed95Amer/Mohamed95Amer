<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_property_document_list" model="ir.ui.view">
        <field name="name">majal.property.document.list</field>
        <field name="model">majal.property.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="reference" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="unit_id" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" string="Days Left"
                       invisible="state == 'permanent'"/>
                <field name="attachment_count" string="Files" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_property_document_form" model="ir.ui.view">
        <field name="name">majal.property.document.form</field>
        <field name="model">majal.property.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_renew" type="object" string="Renew"
                            class="btn-primary" invisible="state == 'permanent'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tenancy contract 2026"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="document_type"/>
                            <field name="reference"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Attached To">
                            <field name="unit_id"/>
                            <field name="development_id"/>
                            <field name="reservation_id"/>
                        </group>
                        <group string="Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"
                                   placeholder="Leave empty if it never lapses"/>
                            <field name="reminder_days"/>
                            <field name="days_to_expiry" invisible="state == 'permanent'"/>
                        </group>
                    </group>
                    <group string="Files">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_property_document_search" model="ir.ui.view">
        <field name="name">majal.property.document.search</field>
        <field name="model">majal.property.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <field name="development_id"/>
                <filter string="Expiring Soon" name="expiring"
                        domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_property_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">majal.property.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_property_document_search"/>
    </record>
</odoo>
