<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_commission_list" model="ir.ui.view">
        <field name="name">majal.commission.list</field>
        <field name="model">majal.commission</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'paid'">
                <field name="broker_id"/>
                <field name="unit_id"/>
                <field name="development_id" optional="show"/>
                <field name="reservation_id" optional="hide"/>
                <field name="sale_price" optional="hide"/>
                <field name="rate" string="Rate %"/>
                <field name="amount" sum="Total"/>
                <field name="payment_date" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_commission_form" model="ir.ui.view">
        <field name="name">majal.commission.form</field>
        <field name="model">majal.commission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="broker_id"/>
                            <field name="reservation_id"/>
                            <field name="unit_id"/>
                            <field name="development_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_price"/>
                            <field name="rate"/>
                            <field name="amount"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_commission_search" model="ir.ui.view">
        <field name="name">majal.commission.search</field>
        <field name="model">majal.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="broker_id"/>
                <field name="unit_id"/>
                <field name="development_id"/>
                <filter string="To Approve" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Pay" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Broker" name="group_broker"
                            context="{'group_by': 'broker_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">majal.commission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_commission_search"/>
    </record>

    <record id="view_partner_form_majal_broker" model="ir.ui.view">
        <field name="name">res.partner.form.majal.broker</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="is_majal_broker"
                       groups="majal_real_estate.group_majal_real_estate_user"/>
                <field name="broker_commission_rate" invisible="not is_majal_broker"
                       groups="majal_real_estate.group_majal_real_estate_user"/>
            </field>
        </field>
    </record>
</odoo>
