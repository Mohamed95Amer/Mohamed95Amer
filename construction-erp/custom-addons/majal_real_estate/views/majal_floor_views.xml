<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_floor_list" model="ir.ui.view">
        <field name="name">majal.floor.list</field>
        <field name="model">majal.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="building_id"/>
                <field name="name"/>
                <field name="number"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="view_majal_floor_form" model="ir.ui.view">
        <field name="name">majal.floor.form</field>
        <field name="model">majal.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Floor 12"/></h1>
                    </div>
                    <group>
                        <field name="building_id"/>
                        <field name="number"/>
                    </group>
                    <notebook>
                        <page string="Units" name="units">
                            <field name="unit_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="unit_category"/>
                                    <field name="status" widget="badge"/>
                                    <field name="total_area"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">majal.floor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
