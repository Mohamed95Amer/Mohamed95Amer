<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_handover_list" model="ir.ui.view">
        <field name="name">majal.handover.list</field>
        <field name="model">majal.handover</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="development_id" optional="show"/>
                <field name="partner_id"/>
                <field name="scheduled_date"/>
                <field name="completed_date" optional="hide"/>
                <field name="open_snag_count" string="Open Snags"/>
                <field name="amount_residual" optional="show" string="Outstanding"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state in ('scheduled', 'inspection', 'ready')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_handover_form" model="ir.ui.view">
        <field name="name">majal.handover.form</field>
        <field name="model">majal.handover</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_inspection" type="object"
                            string="Start Inspection" class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_mark_ready" type="object"
                            string="Mark Ready" class="btn-primary"
                            invisible="state != 'inspection'"/>
                    <button name="action_complete" type="object"
                            string="Complete Handover" class="btn-primary"
                            invisible="state != 'ready'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,inspection,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state == 'completed' or open_snag_count == 0">
                        <field name="open_snag_count" class="oe_inline"/>
                        snag(s) still to be fixed and verified before this unit
                        can be handed over.
                    </div>
                    <group>
                        <group string="Unit">
                            <field name="unit_id" readonly="state != 'draft'"/>
                            <field name="development_id"/>
                            <field name="building_id"/>
                            <field name="floor_id"/>
                        </group>
                        <group string="Buyer">
                            <field name="partner_id" readonly="state == 'completed'"/>
                            <field name="reservation_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_residual"
                                   invisible="not reservation_id"/>
                        </group>
                        <group string="Dates">
                            <field name="scheduled_date"/>
                            <field name="inspection_date"/>
                            <field name="completed_date"/>
                        </group>
                        <group string="Handover Record">
                            <field name="keys_handed"/>
                            <field name="meter_electricity"/>
                            <field name="meter_water"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snag List" name="snags">
                            <field name="snag_ids">
                                <list editable="bottom"
                                      decoration-danger="state == 'open'"
                                      decoration-warning="state == 'fixed'"
                                      decoration-success="state == 'verified'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="location"/>
                                    <field name="severity"/>
                                    <field name="assigned_user_id"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_mark_fixed" type="object"
                                            icon="fa-wrench" title="Mark fixed"
                                            invisible="state != 'open'"/>
                                    <button name="action_verify" type="object"
                                            icon="fa-check" title="Verify"
                                            invisible="state != 'fixed'"/>
                                    <button name="action_reopen" type="object"
                                            icon="fa-undo" title="Reopen"
                                            invisible="state == 'open'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_handover_search" model="ir.ui.view">
        <field name="name">majal.handover.search</field>
        <field name="model">majal.handover</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="development_id"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state', 'in', ['draft', 'scheduled', 'inspection', 'ready'])]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="With Open Snags" name="with_snags"
                        domain="[('open_snag_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_handover" model="ir.actions.act_window">
        <field name="name">Handovers</field>
        <field name="res_model">majal.handover</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_handover_search"/>
    </record>
</odoo>
