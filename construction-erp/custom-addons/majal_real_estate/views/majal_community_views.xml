<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_community_list" model="ir.ui.view">
        <field name="name">majal.community.list</field>
        <field name="model">majal.community</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="development_id"/>
                <field name="building_count"/>
            </list>
        </field>
    </record>

    <record id="view_majal_community_form" model="ir.ui.view">
        <field name="name">majal.community.form</field>
        <field name="model">majal.community</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="development_id"/>
                    </group>
                    <notebook>
                        <page string="Buildings" name="buildings">
                            <field name="building_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="building_type"/>
                                    <field name="floor_count"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_community" model="ir.actions.act_window">
        <field name="name">Communities</field>
        <field name="res_model">majal.community</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
