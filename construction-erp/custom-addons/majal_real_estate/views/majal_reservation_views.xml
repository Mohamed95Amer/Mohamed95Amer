<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_reservation_list" model="ir.ui.view">
        <field name="name">majal.reservation.list</field>
        <field name="model">majal.reservation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'expired')"
                  decoration-success="state == 'converted'">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="development_id" optional="show"/>
                <field name="building_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="user_id" optional="show"/>
                <field name="reservation_date"/>
                <field name="expiry_date"/>
                <field name="sale_price" sum="Total"/>
                <field name="amount_residual" optional="show" string="Outstanding"/>
                <field name="next_due_date" optional="hide"/>
                <field name="broker_id" optional="hide"/>
                <field name="reservation_fee" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'converted'"
                       decoration-danger="state in ('cancelled', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_majal_reservation_form" model="ir.ui.view">
        <field name="name">majal.reservation.form</field>
        <field name="model">majal.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_convert_to_sale" type="object"
                            string="Convert to Sale" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed', 'expired')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('cancelled', 'expired')"/>
                    <button name="action_generate_schedule" type="object"
                            string="Generate Schedule"
                            invisible="state in ('cancelled', 'expired')
                                       or not payment_plan_id"
                            confirm="This replaces the current schedule. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_schedule" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="not installment_ids">
                            <field name="overdue_count" widget="statinfo"
                                   string="Overdue"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Unit">
                            <field name="unit_id"
                                   readonly="state != 'draft'"
                                   domain="[('status', 'in', ['available', 'reserved'])]"/>
                            <field name="development_id"/>
                            <field name="building_id"/>
                            <field name="floor_id"/>
                        </group>
                        <group string="Buyer">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="lead_id" readonly="1"
                                   invisible="not lead_id"/>
                        </group>
                        <group string="Hold Period">
                            <field name="reservation_date" readonly="state != 'draft'"/>
                            <field name="expiry_date"/>
                        </group>
                        <group string="Pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="unit_price"/>
                            <field name="sale_price"/>
                            <field name="reservation_fee"/>
                        </group>
                    </group>
                    <group string="Cancellation" invisible="state != 'cancelled'">
                        <field name="cancel_reason" nolabel="1"
                               placeholder="Why was this reservation cancelled?"/>
                    </group>
                    <notebook>
                        <page string="Payment Schedule" name="schedule">
                            <group>
                                <group>
                                    <field name="payment_plan_id"/>
                                </group>
                                <group>
                                    <field name="amount_scheduled"/>
                                    <field name="amount_paid"/>
                                    <field name="amount_residual"/>
                                    <field name="next_due_date"/>
                                </group>
                            </group>
                            <field name="installment_ids">
                                <list editable="bottom" decoration-danger="is_overdue"
                                      decoration-success="state == 'paid'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="percentage"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_paid" sum="Paid"/>
                                    <field name="amount_residual" sum="Outstanding"/>
                                    <field name="payment_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-warning="state == 'partial'"/>
                                    <button name="action_mark_paid" type="object"
                                            icon="fa-check" title="Mark as fully paid"
                                            invisible="state == 'paid'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Broker" name="broker">
                            <group>
                                <group>
                                    <field name="broker_id"/>
                                    <field name="commission_rate"/>
                                    <field name="commission_amount"/>
                                </group>
                            </group>
                            <field name="commission_ids" readonly="1">
                                <list>
                                    <field name="broker_id"/>
                                    <field name="rate" string="Rate %"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes on this hold..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_majal_reservation_search" model="ir.ui.view">
        <field name="name">majal.reservation.search</field>
        <field name="model">majal.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="development_id"/>
                <field name="user_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Converted" name="converted"
                        domain="[('state', '=', 'converted')]"/>
                <separator/>
                <filter string="Expiring This Week" name="expiring_soon"
                        domain="[('state', '=', 'confirmed'),
                                 ('expiry_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="My Reservations" name="my_reservations"
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Development" name="group_development"
                            context="{'group_by': 'development_id'}"/>
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building_id'}"/>
                    <filter string="Salesperson" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Reservation Date" name="group_date"
                            context="{'group_by': 'reservation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">majal.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_reservation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Reserve a unit for a buyer</p>
            <p>
                Confirming a reservation holds the unit so nobody else can sell
                it. If the hold lapses, the unit returns to the available pool
                automatically.
            </p>
        </field>
    </record>
</odoo>
