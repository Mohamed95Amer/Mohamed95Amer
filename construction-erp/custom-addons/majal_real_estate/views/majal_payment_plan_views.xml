<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_payment_plan_list" model="ir.ui.view">
        <field name="name">majal.payment.plan.list</field>
        <field name="model">majal.payment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="development_id"/>
                <field name="total_percentage" string="Total %"/>
            </list>
        </field>
    </record>

    <record id="view_majal_payment_plan_form" model="ir.ui.view">
        <field name="name">majal.payment.plan.form</field>
        <field name="model">majal.payment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 20/50/30 Construction Linked"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="development_id"
                                   placeholder="All developments"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_percentage" string="Total %"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="percentage"/>
                            <field name="trigger"/>
                            <field name="offset_days"
                                   invisible="trigger != 'days_after'"/>
                        </list>
                    </field>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">majal.payment.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_majal_payment_installment_list" model="ir.ui.view">
        <field name="name">majal.payment.installment.list</field>
        <field name="model">majal.payment.installment</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="is_overdue"
                  decoration-success="state == 'paid'">
                <field name="sequence" widget="handle"/>
                <field name="reservation_id" optional="show"/>
                <field name="unit_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="name"/>
                <field name="due_date"/>
                <field name="percentage" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="amount_paid" sum="Paid"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_date" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'partial'"/>
                <button name="action_mark_paid" type="object" icon="fa-check"
                        title="Mark as fully paid" invisible="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_payment_installment_form" model="ir.ui.view">
        <field name="name">majal.payment.installment.form</field>
        <field name="model">majal.payment.installment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            class="btn-primary" invisible="state == 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="unit_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="due_date"/>
                            <field name="percentage"/>
                            <field name="amount"/>
                            <field name="amount_paid"/>
                            <field name="amount_residual"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_majal_payment_installment_search" model="ir.ui.view">
        <field name="name">majal.payment.installment.search</field>
        <field name="model">majal.payment.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="reservation_id"/>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <filter string="Overdue" name="overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="Unpaid" name="unpaid"
                        domain="[('state', '!=', 'paid')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Buyer" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Reservation" name="group_reservation"
                            context="{'group_by': 'reservation_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Due Date" name="group_due"
                            context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_majal_payment_installment" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">majal.payment.installment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_payment_installment_search"/>
        <field name="context">{'search_default_unpaid': 1}</field>
    </record>
</odoo>
