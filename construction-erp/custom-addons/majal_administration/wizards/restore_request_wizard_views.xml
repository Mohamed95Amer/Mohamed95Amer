<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_restore_request_wizard_form" model="ir.ui.view">
        <field name="name">majal.restore.request.wizard.form</field>
        <field name="model">majal.restore.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare Protected Restore">
                <field name="state" invisible="1"/>
                <div class="alert alert-danger" role="alert" invisible="state != 'confirm'">
                    Restoring replaces every database change and uploaded document
                    created after this recovery point. The live application must be
                    stopped by the deployment operator.
                </div>
                <group invisible="state != 'confirm'">
                    <field name="snapshot_id"/>
                    <field name="database_confirmation"
                           placeholder="Enter the database name shown on the recovery point"/>
                    <field name="loss_confirmation" placeholder="RESTORE ERP"/>
                </group>
                <div class="alert alert-success" role="alert" invisible="state != 'ready'">
                    The request is ready for two hours. Copy the command below to the
                    deployment operator. The recovery code is shown only in this window.
                </div>
                <group invisible="state != 'ready'">
                    <field name="expires_at"/>
                    <field name="recovery_code" password="False"/>
                    <field name="operator_command" widget="text"/>
                </group>
                <footer>
                    <button name="action_prepare" type="object"
                            string="Prepare Restore Request" class="btn-danger"
                            invisible="state != 'confirm'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
