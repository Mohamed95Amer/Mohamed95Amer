<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_user_access_wizard_form" model="ir.ui.view">
        <field name="name">majal.user.access.wizard.form</field>
        <field name="model">majal.user.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Majal Access">
                <div class="alert alert-warning" role="alert">
                    The new access takes effect immediately. Existing sessions may
                    need to refresh before menus are updated.
                </div>
                <group>
                    <field name="user_id"/>
                    <field name="assignable_role_ids" invisible="1"/>
                    <field name="assignable_capability_pack_ids" invisible="1"/>
                    <field name="role_id"/>
                    <field name="industry_scope"/>
                    <field name="capability_pack_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_edit': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Capability packs are optional and audited. Select only one
                    tier per business area. High-risk packs require Platform
                    Owner approval.
                </div>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply Access" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
