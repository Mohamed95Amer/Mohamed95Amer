<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_majal_daily_recovery_point" model="ir.cron">
        <field name="name">Majal: Daily verified recovery point</field>
        <field name="model_id" ref="model_majal_backup_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_recovery_points()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=1, minute=30, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
