<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_capability_pack_list" model="ir.ui.view">
        <field name="name">majal.capability.pack.list</field>
        <field name="model">majal.capability.pack</field>
        <field name="arch" type="xml">
            <list string="Capability Catalog" create="0" edit="0" delete="0">
                <field name="sequence" column_invisible="True"/>
                <field name="family"/>
                <field name="name"/>
                <field name="minimum_role_rank"
                       string="Minimum role rank"
                       optional="hide"/>
                <field name="platform_owner_only"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_majal_capability_pack_form" model="ir.ui.view">
        <field name="name">majal.capability.pack.form</field>
        <field name="model">majal.capability.pack</field>
        <field name="arch" type="xml">
            <form string="Capability Pack" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Optional capability</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="family" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="tier_rank" readonly="1"/>
                            <field name="minimum_role_rank" readonly="1"/>
                        </group>
                        <group>
                            <field name="platform_owner_only" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>
                    <group string="Business boundary">
                        <field name="description" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_capability_packs" model="ir.actions.act_window">
        <field name="name">Capability Catalog</field>
        <field name="res_model">majal.capability.pack</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_majal_capability_pack_list"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="groups_id"
               eval="[(4, ref('group_user_administrator'))]"/>
    </record>
</odoo>
