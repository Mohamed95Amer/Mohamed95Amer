<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_access_level_list" model="ir.ui.view">
        <field name="name">majal.access.role.list</field>
        <field name="model">majal.access.role</field>
        <field name="arch" type="xml">
            <list string="Access Levels" create="0" delete="0">
                <field name="rank" optional="show" string="Rank"/>
                <field name="name"/>
                <field name="company_id" string="Applies to"
                       placeholder="Standard (all companies)"/>
                <field name="has_company_copy" column_invisible="True"/>
                <field name="description" optional="hide"/>
                <button name="action_majal_customise_for_company"
                        type="object"
                        string="Customise for this company"
                        icon="fa-pencil"
                        invisible="company_id or has_company_copy"/>
            </list>
        </field>
    </record>

    <record id="view_majal_access_level_form" model="ir.ui.view">
        <field name="name">majal.access.role.form</field>
        <field name="model">majal.access.role</field>
        <field name="arch" type="xml">
            <form string="Access Level" create="0" delete="0">
                <header>
                    <button name="action_majal_customise_for_company"
                            type="object"
                            string="Customise for this company"
                            class="btn-primary"
                            invisible="company_id or has_company_copy"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="company_id">
                        This is a standard Majal level, shared by every
                        company and read-only. Make your own copy to rename it
                        or change what it grants.
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Access level</span>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Level 3 — Site Engineer"
                                   readonly="not company_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="rank" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   placeholder="Standard (all companies)"/>
                        </group>
                        <group>
                            <field name="active" readonly="not company_id"/>
                            <field name="has_company_copy" invisible="1"/>
                        </group>
                    </group>
                    <group string="What this level means">
                        <field name="description" nolabel="1"
                               readonly="not company_id"/>
                    </group>
                    <notebook>
                        <page string="Always granted" name="always">
                            <field name="group_ids" widget="many2many_tags"
                                   readonly="not company_id"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="With construction access" name="construction">
                            <field name="construction_group_ids"
                                   widget="many2many_tags"
                                   readonly="not company_id"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="With facilities access" name="facilities">
                            <field name="facility_group_ids"
                                   widget="many2many_tags"
                                   readonly="not company_id"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="With property access" name="property">
                            <field name="real_estate_group_ids"
                                   widget="many2many_tags"
                                   readonly="not company_id"
                                   options="{'no_create': True}"/>
                        </page>
                    </notebook>
                    <div class="text-muted mt-2">
                        Changing what a level grants updates everybody who
                        already holds it, in this company, straight away.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_access_levels" model="ir.actions.act_window">
        <field name="name">Access Levels</field>
        <field name="res_model">majal.access.role</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_majal_access_level_list"/>
        <field name="domain">
            ['|', ('company_id', '=', False),
                  ('company_id', 'in', allowed_company_ids)]
        </field>
        <field name="groups_id"
               eval="[(4, ref('group_user_administrator'))]"/>
    </record>
</odoo>
