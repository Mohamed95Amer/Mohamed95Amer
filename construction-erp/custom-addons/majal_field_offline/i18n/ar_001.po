msgstr "لم يعد أمر العمل موجوداً."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "This asset is not assigned to you."
msgstr "هذا الأصل غير مسند إليك."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
