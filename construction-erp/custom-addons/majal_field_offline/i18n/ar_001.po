msgstr "لا يمكن دون اتصال سوى بدء العيوب أو وضع علامة جاهز عليها."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Offline photos must be smaller than 6 MB."
msgstr "يجب أن يقل حجم الصور دون اتصال عن 6 ميغابايت."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Photo and signature answers must be completed online."
msgstr "يجب إكمال إجابات الصور والتوقيع أثناء الاتصال بالإنترنت."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Sync batches may contain at most 100 operations."
msgstr "لا تتجاوز دفعة المزامنة 100 عملية."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "The asset no longer exists."
msgstr "لم يعد هذا الأصل موجوداً."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
