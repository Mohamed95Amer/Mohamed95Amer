#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Daily labor hours must be between 0 and 24."
msgstr "يجب أن تكون ساعات العمل اليومية بين 0 و24."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Invalid defect severity."
msgstr "درجة خطورة العيب غير صالحة."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
msgid "Invalid inspection answer."
msgstr "إجابة الفحص غير صالحة."

#. module: majal_field_offline
#. odoo-python
#: code:addons/majal_field_offline/models/offline_operation.py:0
