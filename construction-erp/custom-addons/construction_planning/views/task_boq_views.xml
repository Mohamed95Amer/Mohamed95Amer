<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_boq" model="ir.ui.view">
        <field name="name">project.task.form.boq</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="construction_planning.view_task_form_planning"/>
        <field name="arch" type="xml">
            <page name="planning_page" position="inside">
                <group string="Bill of Quantities" name="boq_link">
                    <group>
                        <field name="boq_line_ids" widget="many2many_tags"/>
                        <field name="boq_value"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="boq_certified_percent"/>
                        <field name="boq_progress_gap"
                               decoration-danger="boq_progress_gap &gt; 15"
                               decoration-warning="boq_progress_gap &gt; 5"/>
                    </group>
                </group>
                <div class="text-muted">
                    The programme measures work done and the bill measures work
                    agreed; the gap between them is the number to watch.
                </div>
            </page>
        </field>
    </record>

    <record id="view_boq_line_list_programme" model="ir.ui.view">
        <field name="name">construction.boq.line.list.programme</field>
        <field name="model">construction.boq.line</field>
        <field name="inherit_id" ref="construction_boq.view_boq_line_list"/>
        <field name="arch" type="xml">
            <field name="amount_cost" position="after">
                <field name="programme_percent" string="Programme %" optional="show"/>
                <field name="task_count" string="Activities" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
