<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_link_form" model="ir.ui.view">
        <field name="name">construction.task.link.form</field>
        <field name="model">construction.task.link</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="predecessor_id"/>
                    <field name="successor_id"/>
                    <field name="link_type"/>
                    <field name="lag_days"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_task_link_list" model="ir.ui.view">
        <field name="name">construction.task.link.list</field>
        <field name="model">construction.task.link</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="predecessor_id"
                       domain="[('project_id', '=', parent.project_id)]"/>
                <field name="link_type"/>
                <field name="lag_days"/>
            </list>
        </field>
    </record>
</odoo>
