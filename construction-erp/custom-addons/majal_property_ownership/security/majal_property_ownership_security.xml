<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_majal_owners_association" model="res.groups">
        <field name="name">Owners Association</field>
        <field name="category_id"
               ref="majal_real_estate.module_category_majal_real_estate"/>
        <field name="implied_ids"
               eval="[(4, ref('majal_real_estate.group_majal_real_estate_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_majal_service_charge_budget_company" model="ir.rule">
        <field name="name">Service charge budgets: allowed companies</field>
        <field name="model_id" ref="model_majal_service_charge_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_majal_service_charge_budget_line_company" model="ir.rule">
        <field name="name">Service charge budget lines: allowed companies</field>
        <field name="model_id" ref="model_majal_service_charge_budget_line"/>
        <field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_majal_service_charge_company" model="ir.rule">
        <field name="name">Service charges: allowed companies</field>
        <field name="model_id" ref="model_majal_service_charge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_majal_owner_statement_company" model="ir.rule">
        <field name="name">Owner statements: allowed companies</field>
        <field name="model_id" ref="model_majal_owner_statement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_majal_owner_statement_line_company" model="ir.rule">
        <field name="name">Owner statement lines: allowed companies</field>
        <field name="model_id" ref="model_majal_owner_statement_line"/>
        <field name="domain_force">[('statement_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
