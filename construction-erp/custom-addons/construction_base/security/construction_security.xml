<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction" model="ir.module.category">
        <field name="name">Construction</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_construction_user" model="res.groups">
        <field name="name">Site User</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_construction_site_engineer" model="res.groups">
        <field name="name">Site Engineer</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_commercial" model="res.groups">
        <field name="name">Commercial / QS</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
    </record>

    <record id="group_construction_pm" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_site_engineer')), (4, ref('group_construction_commercial'))]"/>
    </record>

    <record id="group_construction_manager" model="res.groups">
        <field name="name">Construction Manager</field>
        <field name="category_id" ref="module_category_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_pm'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
