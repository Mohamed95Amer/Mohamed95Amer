<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_code_list" model="ir.ui.view">
        <field name="name">construction.document.code.list</field>
        <field name="model">construction.document.code</field>
        <field name="arch" type="xml">
            <!-- Editable in place: this is a table of eleven short rows, and
                 opening a form to change three characters is the reason
                 nobody ever changes them. -->
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="prefix"/>
                <field name="padding"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="model_name" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_document_code_form" model="ir.ui.view">
        <field name="name">construction.document.code.form</field>
        <field name="model">construction.document.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="prefix"/>
                            <field name="padding"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        References read PRJ-RFI-0001: the project code, this
                        prefix, then the number. Changing the prefix renames
                        future references; it does not restart the count and
                        it does not touch references already issued.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <!-- A server action rather than an act_window, so that opening the menu
         discovers registers added by a module installed after this one. A
         settings screen missing a document type is indistinguishable, to the
         person looking at it, from one that cannot be configured. -->
    <record id="action_document_code" model="ir.actions.server">
        <field name="name">Document Numbering</field>
        <field name="model_id" ref="model_construction_document_code"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_document_code"
              name="Document Numbering"
              parent="construction_base.menu_construction_config"
              action="action_document_code"
              sequence="20"/>
</odoo>
