<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_majal_document" model="ir.sequence">
        <field name="name">Majal Controlled Document</field>
        <field name="code">majal.document</field>
        <field name="prefix">DOC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_majal_sheet" model="ir.sequence">
        <field name="name">Majal Structured Sheet</field>
        <field name="code">majal.sheet</field>
        <field name="prefix">SHT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
