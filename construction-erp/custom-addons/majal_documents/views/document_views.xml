<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_document_search" model="ir.ui.view">
        <field name="name">majal.document.search</field>
        <field name="model">majal.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="recipient_id"/>
                <filter name="awaiting" string="Awaiting Approval"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', 'in', ('approved', 'issued'))]"/>
                <separator/>
                <filter name="my_approvals" string="My Approvals"
                        domain="[('approver_id', '=', uid), ('state', '=', 'submitted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'document_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_majal_document_list" model="ir.ui.view">
        <field name="name">majal.document.list</field>
        <field name="model">majal.document</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'"
                  decoration-success="state in ('approved', 'issued')"
                  decoration-danger="state == 'rejected'">
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="recipient_id"/>
                <field name="document_date"/>
                <field name="current_revision"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved', 'issued')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_majal_document_version_list" model="ir.ui.view">
        <field name="name">majal.document.version.list</field>
        <field name="model">majal.document.version</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="document_id"/>
                <field name="revision"/>
                <field name="create_date"/>
                <field name="created_by_id"/>
                <field name="checksum"/>
                <field name="attachment_id"/>
            </list>
        </field>
    </record>

    <record id="view_majal_document_version_form" model="ir.ui.view">
        <field name="name">majal.document.version.form</field>
        <field name="model">majal.document.version</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Revision R<field name="revision" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <field name="document_id"/>
                        <field name="create_date"/>
                        <field name="created_by_id"/>
                        <field name="checksum"/>
                        <field name="attachment_id"/>
                    </group>
                    <field name="body_html" widget="html" readonly="1"
                           class="o_majal_document_editor"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_majal_document_form" model="ir.ui.view">
        <field name="name">majal.document.form</field>
        <field name="model">majal.document</field>
        <field name="arch" type="xml">
            <form string="Controlled Document">
                <header>
                    <button name="action_apply_template" string="Apply Template"
                            type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'rejected') or not template_id"/>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve Exact Revision"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-secondary"
                            invisible="state != 'submitted'"/>
                    <button name="action_issue" string="Issue"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft" string="Start New Revision"
                            type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancelled', 'approved')"/>
                    <button name="action_print" string="Preview PDF"
                            type="object" class="btn-secondary"
                            invisible="not current_version_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,issued,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-code-fork" type="object"
                                name="action_view_versions" invisible="not current_version_id">
                            <field name="version_count" widget="statinfo"
                                   string="Revisions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Checksum Locked"
                            bg_color="text-bg-success"
                            invisible="state not in ('approved', 'issued')"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document title"/></h1>
                        <div class="text-muted"><field name="reference"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="project_id"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="recipient_id"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="document_date"
                                   readonly="state not in ('draft', 'rejected')"/>
                        </group>
                        <group>
                            <field name="template_id"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="language"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="approver_id"
                                   readonly="state not in ('draft', 'rejected')"/>
                            <field name="requires_qualified_signature"
                                   readonly="state not in ('draft', 'rejected')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Document Editor" name="editor">
                            <field name="body_html" widget="html"
                                   class="o_majal_document_editor"
                                   readonly="state not in ('draft', 'rejected')"/>
                        </page>
                        <page string="Revision &amp; Approval" name="approval">
                            <group>
                                <group string="Current Revision">
                                    <field name="current_revision"/>
                                    <field name="current_checksum"/>
                                    <field name="current_version_id"/>
                                </group>
                                <group string="Approval Evidence">
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_at"/>
                                    <field name="approved_by_id"/>
                                    <field name="approved_at"/>
                                    <field name="approval_checksum"/>
                                </group>
                            </group>
                            <field name="approval_note"
                                   readonly="state in ('issued', 'cancelled')"/>
                            <field name="version_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="revision"/>
                                    <field name="create_date"/>
                                    <field name="created_by_id"/>
                                    <field name="checksum"/>
                                    <field name="attachment_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_majal_documents" model="ir.actions.act_window">
        <field name="name">Controlled Documents</field>
        <field name="res_model">majal.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_majal_document_search"/>
    </record>

    <record id="action_majal_document_approvals" model="ir.actions.act_window">
        <field name="name">Document Approvals</field>
        <field name="res_model">majal.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted'), ('approver_id', '=', uid)]</field>
    </record>
</odoo>
