<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_log_form" model="ir.ui.view">
        <field name="name">construction.daily.log.form</field>
        <field name="model">construction.daily.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="construction_base.group_construction_pm"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="log_date"/>
                            <field name="prepared_by_id"/>
                        </group>
                        <group>
                            <field name="weather"/>
                            <field name="temperature"/>
                            <field name="total_headcount"/>
                            <field name="total_labour_hours"/>
                            <field name="total_delay_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manpower" name="manpower">
                            <field name="manpower_ids">
                                <list editable="bottom">
                                    <field name="trade"/>
                                    <field name="contractor_id"/>
                                    <field name="headcount"/>
                                    <field name="hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activities" name="activities">
                            <field name="activity_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="location"/>
                                    <field name="boq_line_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delays" name="delays">
                            <field name="delay_ids">
                                <list editable="bottom">
                                    <field name="cause"/>
                                    <field name="category"/>
                                    <field name="hours_lost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_daily_log_list" model="ir.ui.view">
        <field name="name">construction.daily.log.list</field>
        <field name="model">construction.daily.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="log_date"/>
                <field name="project_id"/>
                <field name="weather"/>
                <field name="total_headcount"/>
                <field name="total_delay_hours"/>
                <field name="prepared_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_daily_log_search" model="ir.ui.view">
        <field name="name">construction.daily.log.search</field>
        <field name="model">construction.daily.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="log_date"/>
                <filter name="filter_delays" string="Had Delays"
                        domain="[('total_delay_hours', '>', 0)]"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_month" string="Month"
                        context="{'group_by': 'log_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_daily_log" model="ir.actions.act_window">
        <field name="name">Daily Site Logs</field>
        <field name="res_model">construction.daily.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_daily_log_search"/>
    </record>

    <menuitem id="menu_construction_site"
              name="Site"
              parent="construction_base.menu_construction_root"
              sequence="35"/>

    <menuitem id="menu_construction_daily_log"
              name="Daily Site Logs"
              parent="menu_construction_site"
              action="action_construction_daily_log"
              sequence="10"/>
</odoo>
