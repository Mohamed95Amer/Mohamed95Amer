<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boq_import_form" model="ir.ui.view">
        <field name="name">construction.boq.import.form</field>
        <field name="model">construction.boq.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="boq_id" readonly="context.get('default_boq_id')"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="text-muted">
                    Expected columns (first row as headers):
                    <code>Section Code | Section Name | Item Code | Description |
                    Unit | Quantity | Unit Rate | Material | Labour | Equipment |
                    Subcontract | Overhead</code>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_boq_import" model="ir.actions.act_window">
        <field name="name">Import BOQ Lines</field>
        <field name="res_model">construction.boq.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
