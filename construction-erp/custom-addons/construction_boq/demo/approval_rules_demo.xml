<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two signatures on every bill, at any value. Commercial writes it, so
         commercial reviewing it is not the control — the project manager's
         signature is, and the rule's "not the author" flag makes sure the
         person who typed it cannot be the one who clears it. -->
    <record id="approval_rule_boq" model="construction.approval.rule">
        <field name="name">Bill of Quantities</field>
        <field name="model_id" ref="construction_boq.model_construction_boq"/>
        <field name="amount_from">0</field>
        <field name="amount_to">0</field>
        <field name="sequence">10</field>
        <field name="step_ids" eval="[
            (0, 0, {
                'sequence': 10,
                'name': 'Commercial review',
                'group_id': ref('construction_base.group_construction_commercial'),
            }),
            (0, 0, {
                'sequence': 20,
                'name': 'Project manager',
                'group_id': ref('construction_base.group_construction_pm'),
            }),
        ]"/>
    </record>
</odoo>
