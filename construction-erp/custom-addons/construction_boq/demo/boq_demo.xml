<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="boq_demo_alnoor" model="construction.boq">
        <field name="name">Al Noor Tower — Main Contract BOQ</field>
        <field name="project_id" ref="construction_base.project_demo_alnoor"/>
    </record>

    <record id="boq_section_substructure" model="construction.boq.section">
        <field name="boq_id" ref="boq_demo_alnoor"/>
        <field name="code">01</field>
        <field name="name">Substructure</field>
        <field name="sequence">10</field>
    </record>
    <record id="boq_section_superstructure" model="construction.boq.section">
        <field name="boq_id" ref="boq_demo_alnoor"/>
        <field name="code">02</field>
        <field name="name">Superstructure</field>
        <field name="sequence">20</field>
    </record>
    <record id="boq_section_mep" model="construction.boq.section">
        <field name="boq_id" ref="boq_demo_alnoor"/>
