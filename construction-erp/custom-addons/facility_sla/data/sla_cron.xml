<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SLA states are stored computes over deadlines, so the passage of time
         alone never moves them. This sweep re-evaluates open work orders and
         escalates the ones that have degraded. -->
    <record id="cron_facility_sla_check" model="ir.cron">
        <field name="name">Facilities: check SLA deadlines</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_sla()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
