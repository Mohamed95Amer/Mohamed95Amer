<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="majal_property_ui.PropertyHome">
    <main class="o_property_home">
      <aside class="o_property_rail">
        <div class="o_property_rail_brand"><span>M</span><strong>Majal<small>PROPERTY</small></strong></div>
        <p>PORTFOLIO</p>
        <button t-att-class="{'active': state.view === 'executive'}" t-on-click="() => this.setView('executive')"><i class="fa fa-dashboard"/><span>Overview</span></button>
        <button t-on-click="() => this.openWorkspace('property_portfolio')"><i class="fa fa-building"/><span>Developments</span></button>
        <button t-on-click="() => this.openWorkspace('unit_inventory')"><i class="fa fa-th-large"/><span>Unit inventory</span><em t-esc="state.executive.totalUnits"/></button>
        <button t-on-click="() => this.openWorkspace('leads')"><i class="fa fa-users"/><span>Leads &amp; sales</span><em t-esc="state.executive.openLeads"/></button>
        <p>OPERATIONS</p>
        <button t-on-click="() => this.openWorkspace('leases')"><i class="fa fa-file-text-o"/><span>Leases</span></button>
        <button t-on-click="() => this.openWorkspace('rent_collection')"><i class="fa fa-money"/><span>Collections</span></button>
        <button t-att-class="{'active': state.view === 'operations'}" t-on-click="() => this.setView('operations')"><i class="fa fa-wrench"/><span>Maintenance</span><em t-esc="state.operations.openMaintenance"/></button>
        <button t-on-click="() => this.openWorkspace('handovers')"><i class="fa fa-key"/><span>Handovers</span></button>
        <p>INSIGHTS</p>
        <button t-on-click="() => this.setView('executive')"><i class="fa fa-line-chart"/><span>Performance</span></button>
        <button t-on-click="() => this.openAction('majal_ai.action_ai_workspace')"><i class="fa fa-lightbulb-o"/><span>Majal Intelligence</span></button>
        <div class="o_property_rail_user"><span>PT</span><strong>Portfolio team<small>Role-based workspace</small></strong></div>
      </aside>
      <div class="o_property_surface">
      <nav class="o_property_view_switcher" aria-label="Property control centre views">
        <button t-att-class="{'active': state.view === 'executive'}" t-on-click="() => this.setView('executive')"><i class="fa fa-line-chart"/> Executive overview</button>
        <button t-att-class="{'active': state.view === 'operations'}" t-on-click="() => this.setView('operations')"><i class="fa fa-wrench"/> Operations centre</button>
        <button t-att-class="{'active': state.view === 'workspaces'}" t-on-click="() => this.setView('workspaces')"><i class="fa fa-th-large"/> Workspaces</button>
      </nav>

      <t t-if="state.view === 'executive'">
        <section class="o_property_command_header"><div><span class="o_suite_eyebrow">PORTFOLIO COMMAND CENTER</span><h1>Good morning.</h1><p><t t-esc="today"/> · Live view of the active portfolio</p></div><div class="o_property_header_actions"><button class="btn o_suite_btn_secondary" t-on-click="() => this.setView('workspaces')">Export board pack</button><button class="btn o_suite_btn_primary" t-on-click="() => this.openWorkspace('property_portfolio')">+ Add property</button></div></section>
        <section class="o_property_metric_row">
          <button class="o_property_metric" t-on-click="() => this.openWorkspace('unit_inventory')"><span class="tone_teal"><i class="fa fa-building"/></span><strong t-esc="formatMoney(state.executive.portfolioValue)"/><small>Portfolio value</small><em>Live unit inventory</em></button>
          <button class="o_property_metric" t-on-click="() => this.openWorkspace('leases')"><span class="tone_green"><i class="fa fa-check"/></span><strong><t t-esc="state.executive.occupancy.toFixed(1)"/>%</strong><small>Occupancy</small><em>Across active units</em></button>
          <button class="o_property_metric" t-on-click="() => this.openWorkspace('rent_collection')"><span class="tone_gold"><i class="fa fa-money"/></span><strong><t t-esc="state.executive.collection.toFixed(1)"/>%</strong><small>Collection rate</small><em><t t-esc="formatMoney(state.operations.rentCollected)"/> received</em></button>
          <button class="o_property_metric" t-on-click="() => this.openWorkspace('leads')"><span class="tone_blue"><i class="fa fa-users"/></span><strong t-esc="state.executive.openLeads"/><small>Open sales leads</small><em>Qualified demand</em></button>
        </section>
        <section class="o_property_executive_grid">
          <button class="o_property_feature" t-on-click="() => this.openFeaturedDevelopment()"><img t-att-src="state.executive.developmentImage || '/majal_property_ui/static/src/img/property-waterfront.png'" t-att-alt="state.executive.developmentName"/><span class="o_property_feature_overlay"><small>FEATURED DEVELOPMENT</small><strong t-esc="state.executive.developmentName"/><em>Change this image and featured development from the development record. Open it to review the live portfolio.</em><span><b t-esc="formatMoney(state.executive.portfolioValue)"/> portfolio · <b><t t-esc="state.executive.occupancy.toFixed(0)"/>%</b> occupied</span></span></button>
          <article class="o_property_availability"><header><div><h2>Unit availability</h2><p>Live commercial inventory</p></div><span><t t-esc="state.executive.totalUnits"/> total</span></header><div class="o_property_availability_body"><div class="o_property_donut" t-att-style="`--occupied:${state.executive.occupancy * 3.6}deg`"><span><strong><t t-esc="state.executive.occupancy.toFixed(0)"/>%</strong><small>occupied</small></span></div><ul><li><i class="occupied"/> Occupied <b t-esc="state.executive.occupied"/></li><li><i class="reserved"/> Reserved <b t-esc="state.executive.reserved"/></li><li><i class="blocked"/> Blocked <b t-esc="state.executive.blocked"/></li><li><i class="available"/> Available <b t-esc="state.executive.available"/></li></ul></div></article>
        </section>
        <section class="o_property_lifecycle"><div class="done"><i>✓</i><b>Inquiry</b><small><t t-esc="state.executive.openLeads"/> active</small></div><span/><div class="done"><i>✓</i><b>Visit</b><small>Sales activity</small></div><span/><div class="done"><i>✓</i><b>Offer</b><small>Commercial review</small></div><span/><div class="current"><i>4</i><b>Reserved</b><small><t t-esc="state.executive.reserved"/> held</small></div><span/><div><i>5</i><b>Contract</b><small>Buyer signature</small></div><span/><div><i>6</i><b>Handover</b><small>Keys and closeout</small></div></section>
        <section class="o_property_insight_grid"><article class="o_property_chart"><header><div><h2>Collections vs target</h2><p>Click a month to inspect its scheduled and received rent.</p></div><span><t t-esc="state.executive.collection.toFixed(1)"/>% achieved</span></header><div class="chart-bars"><button t-foreach="state.executive.collectionTrend" t-as="month" t-key="month.key" t-att-class="{'active': state.executive.selectedTrend and state.executive.selectedTrend.key === month.key}" t-att-style="`--h:${month.height}%`" t-att-title="`${month.label}: ${month.rate.toFixed(1)}%`" t-on-click="() => this.selectTrend(month)"><i/><small t-esc="month.label"/></button></div><div class="o_property_chart_detail" t-if="state.executive.selectedTrend"><strong t-esc="state.executive.selectedTrend.label"/><span>Scheduled <b t-esc="formatMoney(state.executive.selectedTrend.scheduled)"/></span><span>Received <b t-esc="formatMoney(state.executive.selectedTrend.paid)"/></span><span>Rate <b><t t-esc="state.executive.selectedTrend.rate.toFixed(1)"/>%</b></span></div></article><article class="o_property_attention"><header><h2>Needs attention</h2><span><t t-esc="state.operations.openMaintenance + state.operations.leasesExpiring"/> open</span></header><button t-on-click="() => this.openWorkspace('installments')"><i class="fa fa-exclamation"/><span><b>Overdue buyer instalments</b><small>Prioritised by financial impact</small></span></button><button t-on-click="() => this.openWorkspace('leases')"><i class="fa fa-clock-o"/><span><b>Leases expiring within 60 days</b><small><t t-esc="state.operations.leasesExpiring"/> renewals to review</small></span></button><button t-on-click="() => this.openWorkspace('handovers')"><i class="fa fa-key"/><span><b>Handover packs</b><small>Documents, inspections and keys</small></span></button></article></section>
      </t>

      <t t-if="state.view === 'operations'">
        <section class="o_property_command_header"><div><span class="o_suite_eyebrow">PROPERTY OPERATIONS</span><h1>Keep every building performing.</h1><p>Leases, collections, inspections and service requests in one daily control view.</p></div><button class="btn o_suite_btn_primary" t-on-click="() => this.openWorkspace('unit_requests')">+ Service request</button></section>
        <section class="o_property_metric_row"><button class="o_property_metric" t-on-click="() => this.openWorkspace('rent_collection')"><span class="tone_green"><i class="fa fa-check"/></span><strong><t t-esc="state.operations.rentScheduled ? (state.operations.rentCollected / state.operations.rentScheduled * 100).toFixed(1) : '100.0'"/>%</strong><small>Rent collected</small><em t-esc="formatMoney(state.operations.rentCollected)"/></button><button class="o_property_metric" t-on-click="() => this.openWorkspace('leases')"><span class="tone_gold"><i class="fa fa-calendar"/></span><strong t-esc="state.operations.leasesExpiring"/><small>Leases expiring</small><em>Next 60 days</em></button><button class="o_property_metric" t-on-click="() => this.openWorkspace('unit_requests')"><span class="tone_red"><i class="fa fa-wrench"/></span><strong t-esc="state.operations.openMaintenance"/><small>Open maintenance</small><em><t t-esc="state.operations.urgentMaintenance"/> urgent</em></button><button class="o_property_metric"><span class="tone_blue"><i class="fa fa-check-square-o"/></span><strong><t t-esc="state.operations.serviceRate.toFixed(0)"/>%</strong><small>Service closure</small><em>Completed requests</em></button></section>
        <section class="o_property_operations_grid"><article class="o_property_chart"><header><div><h2>Rent collection trend</h2><p>Live from the rent schedule.</p></div><span><t t-esc="state.executive.collection.toFixed(1)"/>%</span></header><div class="chart-bars operations"><button t-foreach="state.executive.collectionTrend" t-as="month" t-key="month.key" t-att-class="{'active': state.executive.selectedTrend and state.executive.selectedTrend.key === month.key}" t-att-style="`--h:${month.height}%`" t-on-click="() => this.selectTrend(month)"><i/><small t-esc="month.label"/></button></div><div class="o_property_chart_detail" t-if="state.executive.selectedTrend"><strong t-esc="state.executive.selectedTrend.label"/><span>Scheduled <b t-esc="formatMoney(state.executive.selectedTrend.scheduled)"/></span><span>Received <b t-esc="formatMoney(state.executive.selectedTrend.paid)"/></span></div></article><article class="o_property_expiry"><header><h2>Lease expiry radar</h2><span><t t-esc="state.operations.leasesExpiring"/> leases</span></header><div class="expiry-grid"><button t-foreach="state.operations.expiryBuckets" t-as="bucket" t-key="bucket.index" t-att-class="bucket.tone" t-att-title="`${bucket.label}: ${bucket.count}`" t-on-click="() => this.openWorkspace('leases')"><b t-esc="bucket.count"/><small t-esc="bucket.label"/></button></div><p>Each cell is a real week. Click it to open the tenancy register.</p></article></section>
        <section class="o_property_workflow"><header><div><h2>Maintenance workflow</h2><p>Colour shows urgency; columns show responsibility and progress.</p></div><span><t t-esc="state.operations.openMaintenance"/> active · <t t-esc="state.operations.urgentMaintenance"/> urgent</span></header><div class="workflow-columns"><article><h3>New</h3><button t-foreach="state.operations.maintenanceCards.filter(r => r.state === 'new')" t-as="request" t-key="request.id" t-on-click="() => this.openWorkspace('unit_requests')" t-att-class="{'urgent': request.priority === '2'}"><b t-esc="request.name"/><small t-esc="(request.unit_id &amp;&amp; request.unit_id[1]) || 'Property request'"/><em t-esc="request.category"/></button></article><article><h3>Assigned</h3><button t-foreach="state.operations.maintenanceCards.filter(r => r.state === 'in_progress')" t-as="request" t-key="request.id" t-on-click="() => this.openWorkspace('unit_requests')"><b t-esc="request.name"/><small t-esc="(request.user_id &amp;&amp; request.user_id[1]) || 'Operations team'"/><em>In progress</em></button></article><article><h3>In progress</h3><button t-on-click="() => this.openWorkspace('unit_requests')"><b>Preventive service queue</b><small>Planned maintenance and inspections</small><em>On track</em></button></article><article><h3>Awaiting closure</h3><button t-on-click="() => this.openWorkspace('unit_requests')"><b>Completed visits</b><small>Waiting for occupant confirmation</small><em>Verify and close</em></button></article></div></section>
      </t>

      <t t-if="state.view === 'workspaces'">
        <section class="o_property_hero"><div class="o_property_hero_copy"><span class="o_suite_eyebrow">MAJAL · PROPERTY OPERATIONS CENTER</span><h1>From land to lease, one record per unit.</h1><p>Inventory, sales, payments, handover and tenancy in a single view of the portfolio.</p><div class="o_suite_hero_actions"><button class="btn o_suite_btn_primary" t-on-click="() => this.openWorkspace('unit_inventory')"><i class="fa fa-th"/> Unit inventory</button><button class="btn o_suite_btn_secondary" t-on-click="() => this.openWorkspace('reservations')"><i class="fa fa-handshake-o"/> Sales dashboard</button><button class="btn o_suite_btn_ghost" t-on-click="() => this.openAction('construction_ui.action_my_day')"><i class="fa fa-thumb-tack"/> My day</button></div></div><div class="o_property_hero_meta"><div class="o_suite_meta_line"><span class="o_suite_date" t-esc="today"/><div class="o_suite_status"><span/> Live</div></div><div class="o_suite_focus_panel"><header><span><i class="fa fa-bolt"/> Today's focus</span><small>Live priorities</small></header><div class="o_suite_focus_items"><button t-foreach="focusItems" t-as="item" t-key="item.key" class="o_suite_focus_item" t-on-click="() => this.openFocus(item)"><span class="o_suite_focus_icon"><i t-attf-class="fa {{ item.icon }}"/></span><span><strong t-att-class="{'o_skeleton': state.loading}" t-esc="state.kpis[item.key]"/><small t-esc="item.label"/><em t-esc="item.caption"/></span><i class="fa fa-arrow-right"/></button></div></div></div></section>
        <section class="o_suite_kpis" aria-label="Property overview"><button t-foreach="kpiDefinitions" t-as="kpi" t-key="kpi.key" t-attf-class="o_suite_kpi o_tone_{{ kpi.tone }}" t-on-click="() => this.openWorkspace(kpi.workspace)"><span class="o_suite_kpi_icon"><i t-attf-class="fa {{ kpi.icon }}"/></span><span class="o_suite_kpi_copy"><strong t-att-class="{'o_skeleton': state.loading}" t-esc="state.kpis[kpi.key]"/><small t-esc="kpi.label"/><em t-esc="kpi.hint"/></span><i class="fa fa-arrow-right o_suite_kpi_arrow"/></button></section>
        <section class="o_property_workspace"><div class="o_suite_section_intro"><div><span class="o_suite_eyebrow">WORKSPACES</span><h2>Run the portfolio from one place</h2></div><p>Start from the operational question, then drill into the underlying record.</p></div><div class="o_property_groups"><article class="o_suite_group" t-foreach="appGroups" t-as="group" t-key="group.title"><header><div><h3 t-esc="group.title"/><p t-esc="group.subtitle"/></div><span t-esc="formatAppCount(group.apps.length)"/></header><div class="o_suite_apps"><button t-foreach="group.apps" t-as="app" t-key="app.name" class="o_suite_app" t-on-click="() => this.openWorkspace(app.workspace)"><span t-attf-class="o_suite_app_icon o_tone_{{ app.tone }}"><i t-attf-class="fa {{ app.icon }}"/></span><span class="o_suite_app_copy"><strong t-esc="app.name"/><small t-esc="app.description"/></span><i class="fa fa-chevron-right"/></button></div></article></div></section>
      </t>
      </div>
    </main>
  </t>
</templates>
