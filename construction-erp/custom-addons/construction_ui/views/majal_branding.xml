<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product branding and the client's legal identity are separate.
         Never overwrite res.company.name during a module upgrade.

         The system account's name is not set here. majal_branding owns it —
         it names the assistant and gives it a face in one place, in English,
         which is also the name majal_branding substitutes into message
         bodies. This module used to write an Arabic name over the top, so on
         an English database every chatter thread was authored by a name
         nobody could read, contradicting the body of the very message it
         signed. Two modules cannot both own one identity. -->

    <record id="construction_base.menu_construction_root" model="ir.ui.menu">
        <field name="name">Majal Construction</field>
    </record>
    <record id="facility_asset.menu_facility_root" model="ir.ui.menu">
        <field name="name">Majal Facilities</field>
    </record>

    <record id="action_construction_home" model="ir.actions.client">
        <field name="name">Majal Construction</field>
    </record>
    <record id="action_facility_home" model="ir.actions.client">
        <field name="name">Majal Facilities</field>
    </record>
    <record id="action_construction_my_dashboard" model="ir.actions.act_window">
        <field name="name">My Workspace</field>
    </record>
    <record id="action_facility_my_dashboard" model="ir.actions.act_window">
        <field name="name">My Workspace</field>
    </record>
    <record id="menu_construction_my_dashboard" model="ir.ui.menu">
        <field name="name">My Workspace</field>
    </record>
    <record id="menu_facility_my_dashboard" model="ir.ui.menu">
        <field name="name">My Workspace</field>
    </record>

    <!-- Sits near the top of the menu on purpose. An approvals queue people
         have to go looking for is an approvals queue that runs a week late. -->
    <record id="construction_base.menu_approvals_root" model="ir.ui.menu">
        <field name="name">Approvals</field>
    </record>
    <record id="construction_base.menu_approval_inbox" model="ir.ui.menu">
        <field name="name">Waiting for Me</field>
    </record>

    <record id="construction_base.menu_construction_config" model="ir.ui.menu">
        <field name="name">Settings</field>
    </record>
    <record id="facility_asset.menu_facility_config" model="ir.ui.menu">
        <field name="name">Settings</field>
    </record>
    <record id="facility_asset.menu_facility_assets" model="ir.ui.menu">
        <field name="name">Asset Portfolio</field>
    </record>
    <record id="facility_asset.menu_facility_requests" model="ir.ui.menu">
        <field name="name">Work Orders</field>
    </record>
    <record id="facility_workorder.menu_facility_pm_plans" model="ir.ui.menu">
        <field name="name">Preventive Maintenance</field>
    </record>
</odoo>
