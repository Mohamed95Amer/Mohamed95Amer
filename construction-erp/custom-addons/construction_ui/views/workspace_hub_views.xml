    <!--
        Workspaces are places; registers are lists.

        Every leaf menu used to open a workspace dashboard first, so reaching
        a bill of quantities took two clicks and a full screen of chrome, and
        the breadcrumb read "Submittals / Submittals". Worse, several pairs
        landed on the same page: Forms and Form Templates both opened the
        inspections hub, BOQ and BOQ Analysis both opened the BOQ hub, so two
        different menu entries went to one identical screen.

        So: a register menu opens its records. The five workspaces below keep
        their dashboards, because a workspace is somewhere you arrive rather
        than a list you scan, and the four sections carry an explicit
        "Overview" child for the same page.
    -->
    <record id="construction_base.menu_construction_projects" model="ir.ui.menu">
        <field name="action" ref="action_workspace_projects"/>
    </record>
    <record id="construction_daily_log.menu_construction_site" model="ir.ui.menu">
