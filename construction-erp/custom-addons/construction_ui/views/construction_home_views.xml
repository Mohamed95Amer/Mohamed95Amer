<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_construction_home" model="ir.actions.client">
        <field name="name">Construction Home</field>
        <field name="tag">construction_ui.home</field>
    </record>

    <record id="action_construction_my_dashboard" model="ir.actions.act_window">
        <field name="name">My Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="context">{"disable_toolbar": True}</field>
    </record>

    <record id="construction_base.menu_construction_root" model="ir.ui.menu">
        <field name="action" ref="action_construction_home"/>
        <field name="web_icon">construction_ui,static/description/icon.svg</field>
    </record>

    <menuitem id="menu_construction_home"
              name="Overview"
              parent="construction_base.menu_construction_root"
              action="action_construction_home"
              sequence="1"/>

    <menuitem id="menu_construction_my_dashboard"
              name="My Dashboard"
              parent="construction_base.menu_construction_root"
              action="action_construction_my_dashboard"
              sequence="2"/>
</odoo>
