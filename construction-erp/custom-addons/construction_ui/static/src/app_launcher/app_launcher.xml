<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@t-foreach='apps']" position="replace">
            <DropdownItem
                t-foreach="apps"
                t-as="app"
                t-key="app.id"
                class="{
                    'o_app': true,
                    'o_majal_launcher_app': true,
                    focus: menuService.getCurrentApp() === app,
                }"
                onSelected="() => this.onNavBarDropdownItemSelection(app)"
                attrs="{
                    href: getMenuItemHref(app),
                    'data-menu-xmlid': app.xmlid,
                    'data-section': app.id,
                }"
            >
                <span class="o_majal_launcher_icon">
                    <img t-if="app.webIconData"
                         t-att-src="app.webIconData"
                         t-att-alt="app.name"/>
                </span>
                <span class="o_majal_launcher_label" t-esc="app.name"/>
            </DropdownItem>
        </xpath>
    </t>
</templates>
