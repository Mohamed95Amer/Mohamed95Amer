<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The first drawing in the register must be immediately usable. -->
    <record id="att_ar101_reva" model="ir.attachment">
        <field name="name">AR-101_RevA.pdf</field>
        <field name="datas" type="base64" file="construction_pin/demo/floorplan.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">construction.drawing.revision</field>
        <field name="res_id" eval="ref('construction_drawing.drawing_ar101_reva')"/>
    </record>
    <record id="construction_drawing.drawing_ar101_reva" model="construction.drawing.revision">
        <field name="attachment_id" ref="att_ar101_reva"/>
    </record>
    <record id="att_ar101_revb" model="ir.attachment">
        <field name="name">AR-101_RevB.pdf</field>
        <field name="datas" type="base64" file="construction_pin/demo/floorplan.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">construction.drawing.revision</field>
        <field name="res_id" eval="ref('construction_drawing.drawing_ar101_revb')"/>
    </record>
    <record id="construction_drawing.drawing_ar101_revb" model="construction.drawing.revision">
        <field name="attachment_id" ref="att_ar101_revb"/>
    </record>

    <!-- Give the ME-301 revision a real PDF sheet so the plan viewer shows a
         drawing out of the box on a fresh demo database. -->
    <record id="att_me301_reva" model="ir.attachment">
        <field name="name">ME-301_RevA.pdf</field>
        <field name="datas" type="base64" file="construction_pin/demo/floorplan.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">construction.drawing.revision</field>
        <field name="res_id" eval="ref('construction_drawing.drawing_me301_reva')"/>
    </record>
    <record id="construction_drawing.drawing_me301_reva" model="construction.drawing.revision">
        <field name="attachment_id" ref="att_me301_reva"/>
    </record>

    <!-- A second issued sheet makes revision comparison discoverable and
         usable in every fresh demonstration database. -->
    <record id="drawing_me301_revb" model="construction.drawing.revision">
        <field name="drawing_id" ref="construction_drawing.drawing_me301"/>
        <field name="revision">B</field>
        <field name="issued_for">construction</field>
        <field name="state">current</field>
    </record>
    <record id="att_me301_revb" model="ir.attachment">
        <field name="name">ME-301_RevB.pdf</field>
        <field name="datas" type="base64" file="construction_pin/demo/floorplan.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">construction.drawing.revision</field>
        <field name="res_id" eval="ref('drawing_me301_revb')"/>
    </record>
    <record id="drawing_me301_revb" model="construction.drawing.revision">
        <field name="attachment_id" ref="att_me301_revb"/>
    </record>

    <record id="pin_demo_rfi" model="construction.pin">
        <field name="name">Duct/beam clash — see RFI</field>
        <field name="revision_id" ref="construction_drawing.drawing_me301_reva"/>
        <field name="pin_type">rfi</field>
        <field name="rfi_id" ref="construction_rfi.rfi_demo_submitted"/>
        <field name="pos_x">0.42</field>
        <field name="pos_y">0.55</field>
    </record>
    <record id="pin_demo_note" model="construction.pin">
        <field name="name">Confirm ceiling height here</field>
        <field name="revision_id" ref="construction_drawing.drawing_me301_reva"/>
        <field name="pin_type">note</field>
        <field name="note">Coordinate with architect before MEP first-fix.</field>
        <field name="pos_x">0.7</field>
        <field name="pos_y">0.3</field>
    </record>
</odoo>
