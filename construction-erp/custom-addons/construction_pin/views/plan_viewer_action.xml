<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_plan_viewer" model="ir.actions.client">
        <field name="name">Plan Viewer</field>
        <field name="tag">construction_plan_viewer</field>
    </record>

    <!-- The plan viewer is not a place you go, it is something you open on a
         drawing sheet — the two buttons on the drawing form and revision list
         are the way in. The action itself must stay: construction_ui refs it
         and facility_floorplan reuses the same client-action tag. -->
    <menuitem id="menu_plan_viewer"
              name="Plan Viewer"
              parent="construction_base.menu_construction_engineering"
              action="action_plan_viewer"
              sequence="12"
              active="False"/>
</odoo>
