<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pin_list" model="ir.ui.view">
        <field name="name">construction.pin.list</field>
        <field name="model">construction.pin</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="revision_id"/>
                <field name="pin_type"/>
                <field name="status"/>
                <field name="task_id" optional="show"/>
                <field name="rfi_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pin_form" model="ir.ui.view">
        <field name="name">construction.pin.form</field>
        <field name="model">construction.pin</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_target" type="object"
                            string="Open Linked Record" class="btn-primary"
                            invisible="pin_type == 'note'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pin_type"/>
                            <field name="revision_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="task_id" invisible="pin_type != 'task'"/>
                            <field name="rfi_id" invisible="pin_type != 'rfi'"/>
                            <field name="status"/>
                            <field name="pos_x"/>
                            <field name="pos_y"/>
                        </group>
                    </group>
                    <field name="note" invisible="pin_type != 'note'"
                           placeholder="Note details…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_pin" model="ir.actions.act_window">
        <field name="name">Plan Pins</field>
        <field name="res_model">construction.pin</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
