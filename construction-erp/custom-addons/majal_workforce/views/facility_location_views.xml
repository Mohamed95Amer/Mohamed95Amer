<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facility_location_form_workforce" model="ir.ui.view">
        <field name="name">facility.location.form.workforce</field>
        <field name="model">facility.location</field>
        <field name="inherit_id" ref="facility_asset.view_facility_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']" position="after">
                <separator string="Team"/>
                <field name="allocation_ids"
                       context="{'default_location_id': id}">
                    <list editable="bottom"
                          decoration-muted="state == 'ended'"
                          decoration-info="state == 'planned'">
                        <field name="employee_id"/>
                        <field name="role_id"/>
                        <field name="cascade_children"
                               string="Covers everything below"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="allocation_percent"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'active'"
                               decoration-info="state == 'planned'"/>
                    </list>
                </field>
                <div class="text-muted mt-2">
                    Allocating somebody here also covers the buildings, floors
                    and rooms inside this location unless you say otherwise —
                    without that, a technician on a building would not see the
                    assets in its rooms.
                </div>
                <group string="Derived access">
                    <field name="member_user_ids" readonly="1"
                           widget="many2many_tags"
                           string="Who can see this location"/>
                    <field name="manager_user_id" string="Record owner"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
