<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The rules read membership live, so an allocation that ended overnight
         keeps granting access until something re-projects. This is that
         something. Early enough to be true before the day starts. -->
    <record id="ir_cron_majal_allocation_sync" model="ir.cron">
        <field name="name">Majal: Apply workforce allocations</field>
        <field name="model_id" ref="model_majal_allocation"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_membership()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall"
               eval="(DateTime.now() + relativedelta(days=1)).replace(hour=2, minute=15, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
