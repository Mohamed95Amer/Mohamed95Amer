<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A permit past its window is not an authority. Sweep hourly so work is
         never running under a lapsed permit for long. -->
    <record id="cron_permit_expiry" model="ir.cron">
        <field name="name">HSE: expire permits past their validity</field>
        <field name="model_id" ref="model_construction_permit"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_permits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
