<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_talk_form" model="ir.ui.view">
        <field name="name">construction.toolbox.talk.form</field>
        <field name="model">construction.toolbox.talk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="topic"/>
                        <h1><field name="topic" placeholder="e.g. Working near live edges"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="talk_date"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="presenter_id"/>
                            <field name="contractor_id"/>
                            <field name="duration_minutes"/>
                            <field name="attendee_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Key Points" name="points">
                            <field name="key_points"
                                   placeholder="What was covered..."/>
                        </page>
                        <page string="Attendance" name="attendance">
                            <field name="attendee_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="trade"/>
                                    <field name="contractor_id"/>
                                    <field name="signature" widget="signature"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_talk_list" model="ir.ui.view">
        <field name="name">construction.toolbox.talk.list</field>
        <field name="model">construction.toolbox.talk</field>
        <field name="arch" type="xml">
            <list>
                <field name="talk_date"/>
                <field name="topic"/>
                <field name="project_id"/>
                <field name="presenter_id"/>
                <field name="contractor_id"/>
                <field name="attendee_count" string="Attendees"/>
            </list>
        </field>
    </record>

    <record id="action_toolbox_talk" model="ir.actions.act_window">
        <field name="name">Toolbox Talks</field>
        <field name="res_model">construction.toolbox.talk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
