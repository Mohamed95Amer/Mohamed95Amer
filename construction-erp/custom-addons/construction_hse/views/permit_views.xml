<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_permit_form" model="ir.ui.view">
        <field name="name">construction.permit.form</field>
        <field name="model">construction.permit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Request Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="construction_hse.group_hse_officer"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="construction_hse.group_hse_officer"/>
                    <button name="action_start_work" type="object" string="Start Work"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state not in ('approved', 'active')"
                            groups="construction_hse.group_hse_officer"/>
                    <button name="action_resume" type="object" string="Resume"
                            invisible="state != 'suspended'"
                            groups="construction_hse.group_hse_officer"/>
                    <button name="action_close" type="object" string="Close Permit"
                            invisible="state not in ('approved', 'active', 'suspended')"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Suspended" bg_color="text-bg-warning"
                            invisible="state != 'suspended'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Permit title"/></h1>
                        <h3 class="text-muted"><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="permit_type"/>
                            <field name="project_id"/>
                            <field name="location"/>
                            <field name="task_id"/>
                            <field name="contractor_id"/>
                            <field name="workers_count"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="supervisor_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="is_live" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Scope of the work authorised..."/>
                    <notebook>
                        <page string="Precautions" name="precautions">
                            <field name="precaution_progress" widget="progressbar"/>
                            <field name="precaution_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="mandatory"/>
                                    <field name="checked" widget="boolean_toggle"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Every mandatory precaution must be confirmed
                                before the permit can be approved.
                            </div>
                        </page>
                        <page string="Close-out" name="closeout"
                              invisible="state not in ('closed', 'suspended')">
                            <group>
                                <field name="closed_by_id" readonly="1"/>
                                <field name="closed_date" readonly="1"/>
                                <field name="suspend_reason"
                                       invisible="state != 'suspended'"/>
                            </group>
                            <field name="close_note" placeholder="Area left safe, ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_permit_list" model="ir.ui.view">
        <field name="name">construction.permit.list</field>
        <field name="model">construction.permit</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-muted="state in ('closed', 'rejected')"
                  decoration-bf="is_live">
                <field name="reference"/>
                <field name="name"/>
                <field name="permit_type"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="is_live" string="Live"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"
                       decoration-warning="state == 'suspended'"/>
            </list>
        </field>
    </record>

    <record id="view_permit_search" model="ir.ui.view">
        <field name="name">construction.permit.search</field>
        <field name="model">construction.permit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <filter name="live" string="Live Now" domain="[('is_live', '=', True)]"/>
                <filter name="awaiting" string="Awaiting Approval"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Permit Type"
                            context="{'group_by': 'permit_type'}"/>
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_permit" model="ir.actions.act_window">
        <field name="name">Permits to Work</field>
        <field name="res_model">construction.permit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first permit</p>
            <p>A permit to work authorises a high-risk activity for a stated
               window, once its precautions have been confirmed.</p>
        </field>
    </record>

    <!-- Send a whole selection for approval from the list-view cog. The
         engine always looped over the recordset; until now nothing could
         hand it more than one record. -->
    <record id="action_request_approval_construction_permit" model="ir.actions.server">
        <field name="name">Request Approval</field>
        <field name="model_id" ref="model_construction_permit"/>
        <field name="binding_model_id" ref="model_construction_permit"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_request_approval_selected()</field>
    </record>
</odoo>
