<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_facility_location_form_floorplan" model="ir.ui.view">
        <field name="name">facility.location.form.floorplan</field>
        <field name="model">facility.location</field>
        <field name="inherit_id" ref="facility_asset.view_facility_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[1]" position="after">
                <button name="action_view_floorplans" type="object"
                        class="oe_stat_button" icon="fa-map-o">
                    <field name="floorplan_count" widget="statinfo"
                           string="Floor Plans"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
