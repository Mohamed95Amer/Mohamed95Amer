<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_list" model="ir.ui.view">
        <field name="name">majal.ai.provider.list</field>
        <field name="model">majal.ai.provider</field>
        <field name="arch" type="xml">
            <list decoration-success="is_ready" decoration-muted="not enabled">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="model_name"/>
                <field name="enabled"/>
                <field name="has_api_key"/>
                <field name="is_ready"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">majal.ai.provider.form</field>
        <field name="model">majal.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="action_clear_api_key" type="object"
                            string="Remove API Key" class="btn-secondary"
                            invisible="not has_api_key"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="code" readonly="id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="enabled"/>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Connection">
                            <field name="endpoint" readonly="code not in ['local', 'local_coder']"/>
                            <field name="model_name"/>
                            <field name="timeout_seconds"/>
                            <field name="requires_key" invisible="1"/>
                            <field name="api_key_input" password="True"
                                   placeholder="Paste a new key to replace the existing key"
                                   invisible="not requires_key"/>
                            <field name="api_key_hint" readonly="1"
                                   invisible="not requires_key"/>
                            <field name="is_ready" readonly="1"/>
                        </group>
                    </group>
                    <group string="Usage safeguards">
                        <field name="daily_request_limit"/>
                        <field name="monthly_token_limit"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <field name="provider_note" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="code in ['local', 'local_coder'] or has_api_key">
                        Hosted keys are accepted only when MAJAL_AI_MASTER_KEY is
                        configured on the server. Keys are never returned to the browser.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_providers" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">majal.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ai_usage_list" model="ir.ui.view">
        <field name="name">majal.ai.usage.list</field>
        <field name="model">majal.ai.usage</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'success'">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="input_tokens" sum="Input"/>
                <field name="output_tokens" sum="Output"/>
                <field name="total_tokens" sum="Total"/>
                <field name="latency_ms"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_usage_search" model="ir.ui.view">
        <field name="name">majal.ai.usage.search</field>
        <field name="model">majal.ai.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="provider_id"/>
                <field name="user_id"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_provider" string="Provider"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_day" string="Day"
                            context="{'group_by': 'request_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage &amp; Audit</field>
        <field name="res_model">majal.ai.usage</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_ai_usage_search"/>
    </record>
</odoo>
