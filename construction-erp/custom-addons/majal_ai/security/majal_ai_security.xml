<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_majal_intelligence" model="ir.module.category">
        <field name="name">Majal Intelligence</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_ai_manager" model="res.groups">
        <field name="name">Intelligence Manager</field>
        <field name="category_id" ref="module_category_majal_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ai_conversation_owner" model="ir.rule">
        <field name="name">Majal AI conversations: own records</field>
        <field name="model_id" ref="model_majal_ai_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ai_conversation_admin" model="ir.rule">
        <field name="name">Majal AI conversations: administrator access</field>
        <field name="model_id" ref="model_majal_ai_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_ai_message_owner" model="ir.rule">
        <field name="name">Majal AI messages: own records</field>
        <field name="model_id" ref="model_majal_ai_message"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ai_message_admin" model="ir.rule">
        <field name="name">Majal AI messages: administrator access</field>
        <field name="model_id" ref="model_majal_ai_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_ai_usage_owner" model="ir.rule">
        <field name="name">Majal AI usage: own records</field>
        <field name="model_id" ref="model_majal_ai_usage"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ai_usage_admin" model="ir.rule">
        <field name="name">Majal AI usage: administrator access</field>
        <field name="model_id" ref="model_majal_ai_usage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[
            (4, ref('base.group_system')),
            (4, ref('group_ai_manager'))
        ]"/>
    </record>

    <record id="rule_ai_provider_company" model="ir.rule">
        <field name="name">Majal AI providers: company</field>
        <field name="model_id" ref="model_majal_ai_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[
            (4, ref('base.group_system')),
            (4, ref('group_ai_manager'))
        ]"/>
    </record>
</odoo>
