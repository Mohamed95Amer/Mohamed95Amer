<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_majal_property_listing_list" model="ir.ui.view">
        <field name="name">majal.property.listing.list</field>
        <field name="model">majal.property.listing</field>
        <field name="arch" type="xml">
            <list string="Property Listings">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="development_id"/>
                <field name="listing_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'review'"
                       decoration-success="state == 'published'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state == 'archived'"/>
                <field name="featured" optional="hide"/>
                <field name="available_from" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_majal_property_listing_form" model="ir.ui.view">
        <field name="name">majal.property.listing.form</field>
        <field name="model">majal.property.listing</field>
        <field name="arch" type="xml">
            <form string="Property Listing">
                <header>
                    <button name="action_submit" type="object" string="Submit for Review"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state not in ('review', 'paused')"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="state != 'published'"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="state == 'archived'"/>
                    <button name="action_reset" type="object" string="Reopen"
                            invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,published,paused,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Marina Heights — Tower A 1601"/></h1>
                    </div>
                    <group>
                        <group string="Listing">
                            <field name="unit_id"/>
                            <field name="development_id"/>
                            <field name="featured"/>
                            <field name="available_from"/>
                            <field name="public_url" widget="url"/>
                        </group>
                        <group string="Pricing">
                            <field name="listing_price"/>
                            <field name="original_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="energy_rating"/>
                            <field name="published_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Public Content">
                            <group>
                                <field name="public_title"/>
                                <field name="public_title_ar"/>
                                <field name="image_1920" widget="image" class="oe_avatar"/>
                                <field name="description"/>
                                <field name="description_ar"/>
                            </group>
                        </page>
                        <page string="Unit Details">
                            <group>
                                <field name="bedrooms" readonly="1"/>
                                <field name="bathrooms" readonly="1"/>
                                <field name="total_area" readonly="1"/>
                                <field name="view" readonly="1"/>
                                <field name="orientation" readonly="1"/>
                                <field name="parking_ref" readonly="1"/>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_majal_property_listing" model="ir.actions.act_window">
        <field name="name">Property Listings</field>
        <field name="res_model">majal.property.listing</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="filter_majal_property_listing_published" model="ir.filters">
        <field name="name">Published Listings</field>
        <field name="model_id">majal.property.listing</field>
        <field name="domain">[("state", "=", "published")]</field>
        <field name="is_default" eval="False"/>
    </record>
</odoo>
