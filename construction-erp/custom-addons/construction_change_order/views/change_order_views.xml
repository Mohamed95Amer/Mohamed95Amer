<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Change Order (the register entry; its priced variations sit beneath it) -->
    <record id="view_change_event_form" model="ir.ui.view">
        <field name="name">construction.change.event.form</field>
        <field name="model">construction.change.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_change_order" type="object"
                            string="Create Variation" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_change_orders" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="change_order_count" widget="statinfo"
                                   string="Variations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h3><field name="name" placeholder="Change title"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="origin"/>
                            <field name="source_rfi_id"
                                   invisible="origin != 'rfi'"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="estimated_amount"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <!-- The variations were only reachable through a stat
                         button that was disabled, so a change order never
                         showed what it had actually become. Each row carries
                         its own reason, which is the question anyone opening
                         this record is asking. -->
                    <separator string="Variations"/>
                    <field name="change_order_ids" readonly="1">
                        <list>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="change_type"/>
                            <field name="reason" widget="html"/>
                            <field name="amount_sell_total"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-danger="state == 'rejected'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_change_event_list" model="ir.ui.view">
        <field name="name">construction.change.event.list</field>
        <field name="model">construction.change.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="origin"/>
                <field name="estimated_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'converted'"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_change_event" model="ir.actions.act_window">
        <field name="name">Change Orders</field>
        <field name="res_model">construction.change.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Change Order (Variation) -->
    <record id="view_change_order_form" model="ir.ui.view">
        <field name="name">construction.change.order.form</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_request_approval" type="object"
                            string="Request Approval" class="btn-primary"
                            invisible="state != 'submitted' or approval_state != 'none'"/>
                    <button name="action_view_approval" type="object"
                            string="View Approval"
                            invisible="approval_state == 'none'"/>
                    <!-- Kept for a variation no rule covers. Where one does,
                         the method refuses and names the rule. -->
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'submitted' or approval_state != 'none'"
                            groups="construction_base.group_construction_pm"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="approval_state" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="approval_state != 'pending'">
                        <field name="approval_summary" nolabel="1" readonly="1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boq_lines" type="object"
                                class="oe_stat_button" icon="fa-list"
                                invisible="not boq_section_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">BOQ Lines</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h3><field name="name" placeholder="Variation title"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="boq_id"/>
                            <field name="change_event_id"/>
                            <field name="change_type"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_sell_total"/>
                            <field name="amount_cost_total"/>
                            <field name="approved_date"
                                   invisible="state != 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_code"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_rate"/>
                                    <field name="unit_cost"/>
                                    <field name="amount_sell" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_change_order_list" model="ir.ui.view">
        <field name="name">construction.change.order.list</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="change_type"/>
                <field name="amount_sell_total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_change_order" model="ir.actions.act_window">
        <field name="name">Variation Orders</field>
        <field name="res_model">construction.change.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_change_event"
              name="Change Orders"
              parent="construction_base.menu_construction_commercial"
              action="action_change_event"
              sequence="30"/>
    <menuitem id="menu_change_order"
              name="Variation Orders"
              parent="construction_base.menu_construction_commercial"
              action="action_change_order"
              sequence="35"/>

    <!-- Send a whole selection for approval from the list-view cog. The
         engine always looped over the recordset; until now nothing could
         hand it more than one record. Bound to the Variation, which is
         what carries the approval, not to the Change Order above it. -->
    <record id="action_request_approval_construction_change_order" model="ir.actions.server">
        <field name="name">Request Approval</field>
        <field name="model_id" ref="model_construction_change_order"/>
        <field name="binding_model_id" ref="model_construction_change_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_request_approval_selected()</field>
    </record>
</odoo>
