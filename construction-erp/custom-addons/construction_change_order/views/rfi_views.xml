<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rfi_form_change_event" model="ir.ui.view">
        <field name="name">construction.rfi.form.change.event</field>
        <field name="model">construction.rfi</field>
        <field name="inherit_id" ref="construction_rfi.view_rfi_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reopen']" position="after">
                <button name="action_raise_change_event" type="object"
                        string="Raise Change Event" icon="fa-exchange"
                        invisible="not cost_impact or state == 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
