<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bim_pin_list" model="ir.ui.view">
        <field name="name">construction.bim.pin.list</field>
        <field name="model">construction.bim.pin</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="pin_type"/>
                <field name="model_id" optional="hide"/>
                <field name="storey"/>
                <field name="element_id" optional="hide"/>
                <field name="status"/>
                <field name="author_id" optional="hide"/>
                <field name="has_viewpoint" optional="hide"/>
                <field name="bcf_guid" string="BCF Topic" optional="hide"/>
                <field name="bucket" widget="badge"
                       decoration-danger="bucket == 'blocked'"
                       decoration-warning="bucket == 'open'"
                       decoration-success="bucket == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_bim_pin_form" model="ir.ui.view">
        <field name="name">construction.bim.pin.form</field>
        <field name="model">construction.bim.pin</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_record" type="object"
                            string="Open Linked Record" class="btn-primary"
                            invisible="pin_type == 'note'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="project_id"/>
                            <field name="pin_type"/>
                            <field name="status" readonly="1"/>
                            <field name="author_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="element_id" readonly="1"/>
                            <field name="global_id" readonly="1"/>
                            <field name="storey" readonly="1"/>
                            <field name="has_viewpoint" readonly="1"/>
                            <field name="bcf_guid" readonly="1"
                                   invisible="not bcf_guid"/>
                        </group>
                    </group>
                    <group string="Position in the model" name="position">
                        <group>
                            <field name="pos_x"/>
                            <field name="pos_y"/>
                            <field name="pos_z"/>
                        </group>
                        <group invisible="not has_viewpoint">
                            <field name="cam_x" string="Camera X"/>
                            <field name="cam_y" string="Camera Y"/>
                            <field name="cam_z" string="Camera Z"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bim_pin_search" model="ir.ui.view">
        <field name="name">construction.bim.pin.search</field>
        <field name="model">construction.bim.pin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="storey"/>
                <filter name="open_pins" string="Open"
                        domain="[('bucket', 'in', ['open', 'blocked'])]"/>
                <filter name="from_bcf" string="From BCF"
                        domain="[('bcf_guid', '!=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_id'}"/>
                    <filter name="group_storey" string="Storey"
                            context="{'group_by': 'storey'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'pin_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bcf_import_form" model="ir.ui.view">
        <field name="name">construction.bim.bcf.import.form</field>
        <field name="model">construction.bim.bcf.import</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Upload a BCF 2.1 archive exported from Solibri, Navisworks,
                    BIMcollab, Revizto or any other tool that speaks BCF. Topics
                    that came from here originally are matched on their GUID and
                    updated, so a round trip does not duplicate them.
                </p>
                <group>
                    <field name="model_id" readonly="1"/>
                    <field name="bcf_file" filename="bcf_filename"/>
                    <field name="bcf_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
