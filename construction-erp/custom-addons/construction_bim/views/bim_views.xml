<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bim_model_form" model="ir.ui.view">
        <field name="name">construction.bim.model.form</field>
        <field name="model">construction.bim.model</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_index" type="object" string="Index Elements"
                            class="btn-primary" invisible="not ifc_file"/>
                    <button name="action_open_viewer" type="object"
                            string="Open 3D Viewer" invisible="state == 'draft'"/>
                    <button name="action_make_current" type="object"
                            string="Set as Current"
                            invisible="state in ('draft', 'current')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,indexed,current"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_elements" type="object"
                                icon="fa-cubes" class="oe_stat_button">
                            <field name="element_count" string="Elements"
                                   widget="statinfo"/>
                        </button>
                        <button name="action_view_elements" type="object"
                                icon="fa-link" class="oe_stat_button">
                            <field name="linked_count" string="Linked"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not index_error">
                        <field name="index_error" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tower — architectural"/></h1>
                        <field name="reference" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="discipline"/>
                            <field name="revision"/>
                        </group>
                        <group>
                            <field name="ifc_file" filename="ifc_filename"/>
                            <field name="ifc_filename" invisible="1"/>
                            <field name="file_size" widget="integer"/>
                            <field name="ball_in_court_id"/>
                            <field name="date_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Linked Elements" name="elements">
                            <field name="element_ids" readonly="1"
                                   domain="[('is_linked', '=', True)]">
                                <list>
                                    <field name="storey"/>
                                    <field name="ifc_type"/>
                                    <field name="name"/>
                                    <field name="link_summary"/>
                                    <field name="link_bucket" widget="badge"
                                           decoration-danger="link_bucket == 'blocked'"
                                           decoration-warning="link_bucket == 'open'"
                                           decoration-success="link_bucket == 'done'"/>
                                    <field name="is_orphan" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bim_model_list" model="ir.ui.view">
        <field name="name">construction.bim.model.list</field>
        <field name="model">construction.bim.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="discipline"/>
                <field name="revision"/>
                <field name="element_count"/>
                <field name="linked_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'current'"
                       decoration-muted="state == 'superseded'"/>
            </list>
        </field>
    </record>

    <record id="view_bim_model_search" model="ir.ui.view">
        <field name="name">construction.bim.model.search</field>
        <field name="model">construction.bim.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="project_id"/>
                <filter name="current" string="Current"
                        domain="[('state', '=', 'current')]"/>
                <filter name="has_links" string="Has Linked Elements"
                        domain="[('linked_count', '&gt;', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_discipline" string="Discipline"
                            context="{'group_by': 'discipline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bim_model" model="ir.actions.act_window">
        <field name="name">BIM Models</field>
        <field name="res_model">construction.bim.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload an IFC model</p>
            <p>
                Indexing reads the elements out of the file so an RFI, a defect
                or a bill item can be attached to a specific wall or duct — and
                stay attached when the model is re-exported.
            </p>
        </field>
    </record>

    <record id="view_bim_element_form" model="ir.ui.view">
        <field name="name">construction.bim.element.form</field>
        <field name="model">construction.bim.element</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="global_id" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="project_id"/>
                            <field name="ifc_type" readonly="1"/>
                            <field name="storey" readonly="1"/>
                            <field name="is_orphan" readonly="1"/>
                        </group>
                        <group string="Linked records">
                            <field name="rfi_id"/>
                            <field name="defect_id"/>
                            <field name="task_id"/>
                            <field name="boq_line_id"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bim_element_list" model="ir.ui.view">
        <field name="name">construction.bim.element.list</field>
        <field name="model">construction.bim.element</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="storey" readonly="1"/>
                <field name="ifc_type" readonly="1"/>
                <field name="name"/>
                <field name="rfi_id"/>
                <field name="defect_id"/>
                <field name="task_id"/>
                <field name="boq_line_id" optional="hide"/>
                <field name="link_bucket" widget="badge" readonly="1"
                       decoration-danger="link_bucket == 'blocked'"
                       decoration-warning="link_bucket == 'open'"
                       decoration-success="link_bucket == 'done'"/>
                <field name="is_linked" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bim_element_search" model="ir.ui.view">
        <field name="name">construction.bim.element.search</field>
        <field name="model">construction.bim.element</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="global_id"/>
                <field name="ifc_type"/>
                <filter name="linked" string="Linked"
                        domain="[('is_linked', '=', True)]"/>
                <filter name="blocked" string="Blocked"
                        domain="[('link_bucket', '=', 'blocked')]"/>
                <filter name="orphan" string="Gone from the model"
                        domain="[('is_orphan', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_storey" string="Storey"
                            context="{'group_by': 'storey'}"/>
                    <filter name="group_type" string="IFC Type"
                            context="{'group_by': 'ifc_type'}"/>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bim_element" model="ir.actions.act_window">
        <field name="name">BIM Elements</field>
        <field name="res_model">construction.bim.element</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_linked': 1}</field>
    </record>
</odoo>
